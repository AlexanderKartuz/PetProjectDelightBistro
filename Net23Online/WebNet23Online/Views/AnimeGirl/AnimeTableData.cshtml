@using WebNet23Online.Models.AnimeGirl
@using WebNet23Online.Localizations
@model List<IndexAnimeViewModel>
@{
    Layout = "_LayoutAnime";
}
<div class="anime-grils">
    <div class="girl-row header">
        <div class="girl-cell"><a href="/AnimeGirl/AnimeTableData?sortBy=Id">@AnimeGirl.AnimeTableData_ColumnId</a></div>
        <div class="girl-cell"><a href="/AnimeGirl/AnimeTableData?sortBy=Name">@AnimeGirl.AnimeTableData_ColumnName</a></div>
        <div class="girl-cell"><a href="/AnimeGirl/AnimeTableData?sortBy=CoverUrl">@AnimeGirl.AnimeTableData_ColumnUrl</a></div>
    </div>
    @foreach (var item in Model)
    {
        <div class="girl-row">
            <div class="girl-cell">@item.Id</div>
            <div class="girl-cell">@item.Name</div>
            <div class="girl-cell">@item.Url</div>
        </div>
    }
</div>
