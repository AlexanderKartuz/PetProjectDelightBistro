@using WebNet23Online.Models.AnimeGirl
@using WebNet23Online.Localizations
@model MainIndexViewModel
@{
    Layout = "_LayoutAnime";
}

@section Scripts {
    <script src="/js/anime-girl/anime-girl-chat.js"></script>
    <script src="/js/anime-girl/index.js"></script>

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin="">
    <link href="https://fonts.googleapis.com/css2?family=Nunito:wght@400;600;700&amp;family=Sniglet:wght@400;800&amp;display=swap" rel="stylesheet">
    <link rel="stylesheet" href="/css/anime-girl/style-nice.css">
}

<title>@AnimeGirl.Index_PageTitle</title>
<div id="anime-girl-l10n" hidden
     data-chat-user-label="@AnimeGirl.Index_Chat_UserLabel"
     data-chat-user-joined="@AnimeGirl.Chat_UserJoined"
     data-chat-user-left="@AnimeGirl.Chat_UserLeft"
     data-chat-me="@AnimeGirl.Chat_Me"
     data-chat-select-characters="@AnimeGirl.Chat_SelectCharactersFirst"
     data-chat-shared-by-you="@AnimeGirl.Chat_SharedByYou"
     data-chat-shared-by-user="@AnimeGirl.Chat_SharedByUser"
     data-hero-likes="@AnimeGirl.Index_Heroes_Likes"
     data-hero-alt="@AnimeGirl.Index_Hero_Alt"
     data-notification-new-anime="@AnimeGirl.Notification_NewAnime"></div>
<div class="bg-blobs" aria-hidden="true"></div>
<header class="site-header">
    <p class="tagline">@AnimeGirl.Index_Header_TagLine</p>
    <h1>@AnimeGirl.Index_Header</h1>
    <p class="lead">@AnimeGirl.Index_Lead</p>
    <nav class="page-size-links" aria-label="@AnimeGirl.Index_Heroes_PageSize_Aria">
        <a class="page-size-link @(Model.HeroesFilter.PageSize == 1 ? "active" : "")"
           asp-controller="AnimeGirl"
           asp-action="Index"
           asp-route-page="1"
           asp-route-pageSize="1"
           asp-fragment="heroes">@AnimeGirl.Index_LinkOnlyOne</a>
        <a class="page-size-link @(Model.HeroesFilter.PageSize == 2 ? "active" : "")"
           asp-controller="AnimeGirl"
           asp-action="Index"
           asp-route-page="1"
           asp-route-pageSize="2"
           asp-fragment="heroes">@AnimeGirl.Index_LinkTwoEnough</a>
        <a class="page-size-link @(Model.HeroesFilter.PageSize == 3 ? "active" : "")"
           asp-controller="AnimeGirl"
           asp-action="Index"
           asp-route-page="1"
           asp-route-pageSize="3"
           asp-fragment="heroes">@AnimeGirl.Index_LinkMore</a>
        <a class="page-size-link @(Model.HeroesFilter.PageSize == 6 ? "active" : "")"
           asp-controller="AnimeGirl"
           asp-action="Index"
           asp-route-page="1"
           asp-route-pageSize="6"
           asp-fragment="heroes">6</a>
        <a class="page-size-link @(Model.HeroesFilter.PageSize == 12 ? "active" : "")"
           asp-controller="AnimeGirl"
           asp-action="Index"
           asp-route-page="1"
           asp-route-pageSize="12"
           asp-fragment="heroes">12</a>
        <a class="page-size-link @(Model.HeroesFilter.PageSize == 0 ? "active" : "")"
           asp-controller="AnimeGirl"
           asp-action="Index"
           asp-route-page="1"
           asp-route-pageSize="0"
           asp-fragment="heroes">@AnimeGirl.Index_Heroes_PageSize_All</a>
    </nav>
</header>

<main>
    @if (Model.Joke != null || Model.Waifu?.items?.Count > 0 || Model.Cats?.Count > 0)
    {
        <section class="section section-fun" id="fun-stuff" aria-labelledby="fun-stuff-title">
            <h2 class="section-title" id="fun-stuff-title">@AnimeGirl.Index_FunSection_Title</h2>
            <p class="section-intro">@AnimeGirl.Index_FunSection_Intro</p>

            <div class="fun-grid">
                @if (Model.Joke != null)
                {
                    <article class="fun-card fun-card--joke" aria-labelledby="joke-title">
                        <div class="fun-card__header">
                            <span class="fun-card__icon" aria-hidden="true">😄</span>
                            <h3 class="fun-card__title" id="joke-title">@AnimeGirl.Index_Joke_Title</h3>
                            @if (!string.IsNullOrEmpty(Model.Joke.type))
                            {
                                <span class="fun-card__badge">@Model.Joke.type</span>
                            }
                        </div>
                        <blockquote class="joke-quote">
                            <p class="joke-setup">@Model.Joke.setup</p>
                            <p class="joke-punchline">@Model.Joke.punchline</p>
                        </blockquote>
                    </article>
                }

                @if (Model.Waifu?.items?.Count > 0)
                {
                    var waifuImage = Model.Waifu.items[0];
                    <article class="fun-card fun-card--waifu" aria-labelledby="waifu-title">
                        <div class="fun-card__header">
                            <span class="fun-card__icon" aria-hidden="true">🌸</span>
                            <h3 class="fun-card__title" id="waifu-title">@AnimeGirl.Index_Waifu_Title</h3>
                        </div>
                        <div class="fun-card__img-wrap fun-card__img-wrap--waifu">
                            <img src="@waifuImage.url"
                                 alt="@AnimeGirl.Index_Waifu_Alt"
                                 width="@(waifuImage.width > 0 ? waifuImage.width : 480)"
                                 height="@(waifuImage.height > 0 ? waifuImage.height : 720)"
                                 loading="lazy"
                                 decoding="async">
                        </div>
                        <p class="fun-card__link-wrap">
                            <a class="fun-card__link" href="@waifuImage.url" target="_blank" rel="noopener noreferrer">@AnimeGirl.Index_Waifu_OpenOriginal</a>
                        </p>
                    </article>
                }
            </div>

            @if (Model.Cats?.Count > 0)
            {
                <div class="fun-cats">
                    <div class="fun-cats__header">
                        <span class="fun-card__icon" aria-hidden="true">🐱</span>
                        <h3 class="fun-card__title">@AnimeGirl.Index_Cats_Title</h3>
                    </div>
                    <div class="fun-cats-grid">
                        @foreach (var cat in Model.Cats)
                        {
                            var catUrl = $"https://cataas.com/cat/{cat.id}";
                            var catLabel = $"{AnimeGirl.Index_Cat_Alt} {cat.id}";
                            <article class="fun-cat-card">
                                <a class="fun-cat-card__link" href="@catUrl" target="_blank" rel="noopener noreferrer" title="@catLabel">
                                    <div class="fun-cat-card__img-wrap">
                                        <img src="@catUrl"
                                             alt="@catLabel"
                                             width="320"
                                             height="320"
                                             loading="lazy"
                                             decoding="async">
                                    </div>
                                </a>
                            </article>
                        }
                    </div>
                </div>
            }
        </section>
    }

    <section class="section section-link" id="link-anime-hero" aria-labelledby="link-anime-hero-title">
        <h2 class="section-title" id="link-anime-hero-title">@AnimeGirl.Index_LinkSection_Title</h2>
        <p class="section-intro">@AnimeGirl.Index_LinkSection_Intro</p>
        <form action="/AnimeGirl/LinkAnimeAndGirl" method="post">
            <div class="link-toolbar" role="group" aria-label="@AnimeGirl.Index_LinkSection_GroupLabel">
                <div class="link-field">
                    <label class="link-label" for="select-anime">@AnimeGirl.Index_LinkSection_AnimeLabel</label>
                    <select id="select-anime" class="link-select" name="animeId">
                        <option value="">@AnimeGirl.Index_LinkSection_SelectAnime</option>
                        @foreach (var anime in Model.Animes)
                        {
                            <option value="@anime.Id">@anime.Name</option>
                        }
                    </select>
                </div>
                <div class="link-field">
                    <label class="link-label" for="select-hero">@AnimeGirl.Index_LinkSection_HeroLabel</label>
                    <select id="select-hero" class="link-select" name="heroId">
                        <option value="">@AnimeGirl.Index_LinkSection_SelectHero</option>
                        @foreach (var girl in Model.AllAnimeGirls)
                        {
                            var optLabel = string.IsNullOrEmpty(girl.ConnectedAnimeTitles)
                            ? girl.Title
                            : $"{girl.Title} — {girl.ConnectedAnimeTitles}";
                            <option value="@girl.Id" title="@optLabel">@optLabel</option>
                        }
                    </select>
                </div>
                <button type="submit" class="link-button">@AnimeGirl.Index_LinkSection_Button</button>
            </div>
        </form>
    </section>

    <section class="section section-anime-catalog" id="anime-catalog" aria-labelledby="anime-catalog-title">
        <h2 class="section-title" id="anime-catalog-title">@AnimeGirl.Index_AnimeCatalog_Title</h2>
        <p class="section-intro">@AnimeGirl.Index_AnimeCatalog_Intro</p>
        <div class="anime-catalog-grid">
            @foreach (var anime in Model.Animes)
            {
                <article class="anime-catalog-card" data-id="@anime.Id">
                    <div class="anime-catalog-card__cover">
                        <img src="@anime.Url" alt="@($"{AnimeGirl.Index_AnimeCatalog_CoverAlt} {anime.Name}")" width="480" height="720" loading="lazy" decoding="async">
                    </div>
                    <div class="anime-catalog-card__body">
                        <h3 class="mode-view anime-catalog-card__title">@anime.Name</h3>
                        <input value="" class="new-anime-name-input mode-edit link-select">
                    </div>
                </article>
            }
        </div>
    </section>


    <section class="section section-anime-catalog section-movie-catalog" id="movie-catalog" aria-labelledby="movie-catalog-title">
        <h2 class="section-title" id="movie-catalog-title">@AnimeGirl.Index_MovieCatalog_Title</h2>
        <p class="section-intro">@AnimeGirl.Index_MovieCatalog_Intro</p>
        <div class="anime-catalog-grid">

            <article class="anime-catalog-card create-new-film" data-id="***">
                <div class="anime-catalog-card__cover">
                    <img src="***" alt="***" width="480" height="720" loading="lazy" decoding="async">
                </div>
                <div class="anime-catalog-card__body">
                    <input value="" class="movie-name-input link-select" placeholder="@AnimeGirl.Index_MovieCatalog_NamePlaceholder">
                    <input value="" class="movie-url-input link-select" placeholder="@AnimeGirl.Index_MovieCatalog_UrlPlaceholder">
                    <button class="create-movie-button link-select">@AnimeGirl.Index_MovieCatalog_CreateButton</button>
                </div>
            </article>
            
            <article class="anime-catalog-card template" data-id="***">
                <div class="anime-catalog-card__cover">
                    <img src="***" alt="***" width="480" height="720" loading="lazy" decoding="async">
                </div>
                <div class="anime-catalog-card__body">
                    <h3 class="mode-view anime-catalog-card__title">***</h3>
                    <input value="" class="new-anime-name-input mode-edit link-select">
                </div>
            </article>

        </div>
    </section>

    <section class="section section-heroes" id="heroes" aria-labelledby="heroes-title">
        <h2 class="section-title" id="heroes-title">@AnimeGirl.Index_Heroes_Title</h2>
        <p class="section-intro">@AnimeGirl.Index_Heroes_Intro</p>
        <div class="heroes-toolbar">
            <p class="heroes-toolbar__actions">
                <button class="remove-image link-button" disabled>@AnimeGirl.Index_Heroes_Remove</button>
            </p>
            <form asp-controller="AnimeGirl"
                  asp-action="Index"
                  asp-fragment="heroes"
                  method="get"
                  class="heroes-page-size-form">
                <label class="heroes-page-size-label" for="heroes-page-size">@AnimeGirl.Index_Heroes_PageSize_Label</label>
                <select id="heroes-page-size"
                        name="pageSize"
                        class="link-select heroes-page-size-select"
                        onchange="this.form.submit()">
                    @{
                        var heroesPageSizeOptions = new (int Value, string Label)[]
                        {
                            (1, "1"),
                            (2, "2"),
                            (3, "3"),
                            (6, "6"),
                            (12, "12"),
                            (0, AnimeGirl.Index_Heroes_PageSize_All)
                        };
                    }
                    @foreach (var option in heroesPageSizeOptions)
                    {
                        if (Model.HeroesFilter.PageSize == option.Value)
                        {
                            <option value="@option.Value" selected="selected">@option.Label</option>
                        }
                        else
                        {
                            <option value="@option.Value">@option.Label</option>
                        }
                    }
                </select>
                <input type="hidden" name="page" value="1">
            </form>
        </div>

        <div class="card-grid">
            @foreach (var girl in Model.AnimeGirls)
            {
                <article class="media-card" data-id="@girl.Id" data-likes="@girl.Likes">
                    <div class="media-card__img-wrap">
                        <img src="@girl.Url" alt="@($"{AnimeGirl.Index_Hero_Alt} {girl.Title}")" width="400" height="500" loading="lazy" decoding="async">
                    </div>
                    <div class="media-card__text">
                        <p class="media-card__name">@girl.Title</p>
                        <p class="media-card__likes">@($"{AnimeGirl.Index_Heroes_Likes} {girl.Likes}")</p>
                        @if (!string.IsNullOrEmpty(girl.ConnectedAnimeTitles))
                        {
                            <p class="media-card__animes">@girl.ConnectedAnimeTitles</p>
                        }
                        @if (Model.CanDeleteGirl)
                        {
                            <p class="media-card__animes"><a class="delete-girl-link" href="/AnimeGirl/Delete?id=@girl.Id">@AnimeGirl.Index_Heroes_Delete</a></p>
                        }
                    </div>
                </article>
            }
        </div>

        @if (Model.HeroesFilter.PageSize != 0 && Model.HeroesPagination.TotalPages > 1)
        {
            <nav class="heroes-pagination" aria-label="@AnimeGirl.Index_Heroes_Pagination_Aria">
                @if (Model.HeroesPagination.HasPreviousPage)
                {
                    <a class="heroes-pagination__btn"
                       asp-controller="AnimeGirl"
                       asp-action="Index"
                       asp-route-page="@(Model.HeroesPagination.CurrentPage - 1)"
                       asp-route-pageSize="@Model.HeroesFilter.PageSize"
                       asp-fragment="heroes"
                       aria-label="@AnimeGirl.Index_Heroes_Prev">&larr;</a>
                }

                @{
                    var startPageToShow = Math.Max(1, Model.HeroesPagination.CurrentPage - 2);
                    var endPageToShow = Math.Min(Model.HeroesPagination.TotalPages, startPageToShow + 4);

                    if (startPageToShow > 1)
                    {
                        <a class="heroes-pagination__btn"
                           asp-controller="AnimeGirl"
                           asp-action="Index"
                           asp-route-page="1"
                           asp-route-pageSize="@Model.HeroesFilter.PageSize"
                           asp-fragment="heroes">1</a>

                        if (startPageToShow > 2)
                        {
                            <span class="heroes-pagination__btn heroes-pagination__btn--disabled">...</span>
                        }
                    }

                    for (int i = startPageToShow; i <= endPageToShow; i++)
                    {
                        if (i == Model.HeroesPagination.CurrentPage)
                        {
                            <span class="heroes-pagination__btn heroes-pagination__btn--active">@i</span>
                        }
                        else
                        {
                            <a class="heroes-pagination__btn"
                               asp-controller="AnimeGirl"
                               asp-action="Index"
                               asp-route-page="@i"
                               asp-route-pageSize="@Model.HeroesFilter.PageSize"
                               asp-fragment="heroes">@i</a>
                        }
                    }

                    if (endPageToShow < Model.HeroesPagination.TotalPages)
                    {
                        if (endPageToShow < Model.HeroesPagination.TotalPages - 1)
                        {
                            <span class="heroes-pagination__btn heroes-pagination__btn--disabled">...</span>
                        }

                        <a class="heroes-pagination__btn"
                           asp-controller="AnimeGirl"
                           asp-action="Index"
                           asp-route-page="@Model.HeroesPagination.TotalPages"
                           asp-route-pageSize="@Model.HeroesFilter.PageSize"
                           asp-fragment="heroes">@Model.HeroesPagination.TotalPages</a>
                    }
                }

                @if (Model.HeroesPagination.HasNextPage)
                {
                    <a class="heroes-pagination__btn"
                       asp-controller="AnimeGirl"
                       asp-action="Index"
                       asp-route-page="@(Model.HeroesPagination.CurrentPage + 1)"
                       asp-route-pageSize="@Model.HeroesFilter.PageSize"
                       asp-fragment="heroes"
                       aria-label="@AnimeGirl.Index_Heroes_Next">&rarr;</a>
                }
            </nav>
        }
    </section>

    <section class="section section-placeholder" id="games">
        <h2 class="section-title">@AnimeGirl.Index_Games_Title</h2>
        <div class="placeholder-box">
            <span class="placeholder-icon" aria-hidden="true">🎮</span>
            <p>@AnimeGirl.Index_Games_Placeholder</p>
        </div>
    </section>

    <section class="section section-placeholder" id="books">
        <h2 class="section-title">@AnimeGirl.Index_Books_Title</h2>
        <div class="placeholder-box">
            <span class="placeholder-icon" aria-hidden="true">📚</span>
            <p>@AnimeGirl.Index_Books_Placeholder</p>
        </div>
    </section>
</main>

<footer class="site-footer">
    <p>@AnimeGirl.Index_Footer</p>
</footer>

<button type="button"
        class="anime-chat-toggle"
        aria-label="@AnimeGirl.Index_Chat_OpenAria"
        aria-expanded="false"
        aria-controls="anime-chat-panel">
    💬
</button>

<aside id="anime-chat-panel" class="anime-chat-panel" aria-label="@AnimeGirl.Index_Chat_PanelAria">
    <div class="anime-chat-panel__header">
        <div>
            <h2 class="anime-chat-panel__title">@AnimeGirl.Index_Chat_Title</h2>
            <span class="anime-chat-panel__user">@($"{AnimeGirl.Index_Chat_UserLabel} …")</span>
        </div>
        <button type="button" class="anime-chat-panel__close" aria-label="@AnimeGirl.Index_Chat_CloseAria">&times;</button>
    </div>
    <div class="anime-chat-messages" aria-live="polite"></div>
    <div class="anime-chat-toolbar">
        <button type="button" class="anime-chat-share" disabled>@AnimeGirl.Index_Chat_Share</button>
    </div>
    <div class="anime-chat-input-box">
        <input type="text"
               class="anime-chat-input"
               placeholder="@AnimeGirl.Index_Chat_MessagePlaceholder"
               maxlength="500"
               autocomplete="off">
        <button type="button" class="anime-chat-send">@AnimeGirl.Index_Chat_Send</button>
    </div>
</aside>

<template id="anime-chat-message-template">
    <div class="anime-chat-message">
        <div class="anime-chat-message__sender"></div>
        <div class="anime-chat-message__text"></div>
    </div>
</template>

<template id="anime-chat-share-card-template">
    <article class="anime-chat-share-card">
        <div class="anime-chat-share-card__img-wrap">
            <img class="anime-chat-share-card__img" alt="" width="120" height="150" loading="lazy" decoding="async">
        </div>
        <p class="anime-chat-share-card__title"></p>
        <p class="anime-chat-share-card__likes"></p>
    </article>
</template>
