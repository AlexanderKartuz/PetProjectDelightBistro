@using WebNet23Online.Models.AnimeGirl
@using WebNet23Online.Localizations
@model MainIndexViewModel
@{
    Layout = "_LayoutAnime";
}

@section Scripts {
    <script src="/js/anime-girl/anime-girl-chat.js"></script>
    <script src="/js/anime-girl/index.js"></script>

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin="">
    <link href="https://fonts.googleapis.com/css2?family=Nunito:wght@400;600;700&amp;family=Sniglet:wght@400;800&amp;display=swap" rel="stylesheet">
    <link rel="stylesheet" href="/css/anime-girl/style-nice.css">
}

<title>Мои увлечения — аниме, игры, книги</title>
<div class="bg-blobs" aria-hidden="true"></div>
<header class="site-header">
    <p class="tagline">@AnimeGirl.Index_Header_TagLine</p>
    <h1>@AnimeGirl.Index_Header</h1>
    <p class="lead">Здесь собираю то, что нравится: пока подробно про аниме — игры и книги добавлю позже.</p>
    <a href="/AnimeGirl/Index?count=1">The only one</a>
    <a href="/AnimeGirl/Index?count=2">Two is enought</a>
    <a href="/AnimeGirl/Index?count=3">MORE</a>
</header>

<main>
    @if (Model.Joke != null || Model.Waifu?.items?.Count > 0 || Model.Cats?.Count > 0)
    {
        <section class="section section-fun" id="fun-stuff" aria-labelledby="fun-stuff-title">
            <h2 class="section-title" id="fun-stuff-title">Немного позитива</h2>
            <p class="section-intro">Случайная шутка, waifu и котики — подгружаются при каждом открытии страницы.</p>

            <div class="fun-grid">
                @if (Model.Joke != null)
                {
                    <article class="fun-card fun-card--joke" aria-labelledby="joke-title">
                        <div class="fun-card__header">
                            <span class="fun-card__icon" aria-hidden="true">😄</span>
                            <h3 class="fun-card__title" id="joke-title">Шутка дня</h3>
                            @if (!string.IsNullOrEmpty(Model.Joke.type))
                            {
                                <span class="fun-card__badge">@Model.Joke.type</span>
                            }
                        </div>
                        <blockquote class="joke-quote">
                            <p class="joke-setup">@Model.Joke.setup</p>
                            <p class="joke-punchline">@Model.Joke.punchline</p>
                        </blockquote>
                    </article>
                }

                @if (Model.Waifu?.items?.Count > 0)
                {
                    var waifuImage = Model.Waifu.items[0];
                    <article class="fun-card fun-card--waifu" aria-labelledby="waifu-title">
                        <div class="fun-card__header">
                            <span class="fun-card__icon" aria-hidden="true">🌸</span>
                            <h3 class="fun-card__title" id="waifu-title">Waifu</h3>
                        </div>
                        <div class="fun-card__img-wrap fun-card__img-wrap--waifu">
                            <img src="@waifuImage.url"
                                 alt="Waifu illustration"
                                 width="@(waifuImage.width > 0 ? waifuImage.width : 480)"
                                 height="@(waifuImage.height > 0 ? waifuImage.height : 720)"
                                 loading="lazy"
                                 decoding="async">
                        </div>
                        <p class="fun-card__link-wrap">
                            <a class="fun-card__link" href="@waifuImage.url" target="_blank" rel="noopener noreferrer">Открыть оригинал</a>
                        </p>
                    </article>
                }
            </div>

            @if (Model.Cats?.Count > 0)
            {
                <div class="fun-cats">
                    <div class="fun-cats__header">
                        <span class="fun-card__icon" aria-hidden="true">🐱</span>
                        <h3 class="fun-card__title">Котики</h3>
                    </div>
                    <div class="fun-cats-grid">
                        @foreach (var cat in Model.Cats)
                        {
                            var catUrl = $"https://cataas.com/cat/{cat.id}";
                            <article class="fun-cat-card">
                                <a class="fun-cat-card__link" href="@catUrl" target="_blank" rel="noopener noreferrer" title="Кот @cat.id">
                                    <div class="fun-cat-card__img-wrap">
                                        <img src="@catUrl"
                                             alt="Кот @cat.id"
                                             width="320"
                                             height="320"
                                             loading="lazy"
                                             decoding="async">
                                    </div>
                                </a>
                            </article>
                        }
                    </div>
                </div>
            }
        </section>
    }

    <section class="section section-link" id="link-anime-hero" aria-labelledby="link-anime-hero-title">
        <h2 class="section-title" id="link-anime-hero-title">Связать персонажа с аниме</h2>
        <p class="section-intro">Выберите аниме и персонажа — сохранение связи подключим позже.</p>
        <form action="/AnimeGirl/LinkAnimeAndGirl" method="post">
            <div class="link-toolbar" role="group" aria-label="Выбор аниме и персонажа">
                <div class="link-field">
                    <label class="link-label" for="select-anime">Аниме</label>
                    <select id="select-anime" class="link-select" name="animeId">
                        <option value="">Выберите аниме</option>
                        @foreach (var anime in Model.Animes)
                        {
                            <option value="@anime.Id">@anime.Name</option>
                        }
                    </select>
                </div>
                <div class="link-field">
                    <label class="link-label" for="select-hero">Персонаж</label>
                    <select id="select-hero" class="link-select" name="heroId">
                        <option value="">Выберите персонажа</option>
                        @foreach (var girl in Model.AnimeGirls)
                        {
                            var optLabel = string.IsNullOrEmpty(girl.ConnectedAnimeTitles)
                            ? girl.Title
                            : $"{girl.Title} — {girl.ConnectedAnimeTitles}";
                            <option value="@girl.Id" title="@optLabel">@optLabel</option>
                        }
                    </select>
                </div>
                <button type="submit" class="link-button">Связать</button>
            </div>
        </form>
    </section>

    <section class="section section-anime-catalog" id="anime-catalog" aria-labelledby="anime-catalog-title">
        <h2 class="section-title" id="anime-catalog-title">Каталог аниме</h2>
        <p class="section-intro">Обложки и названия — то, что уже в коллекции.</p>
        <div class="anime-catalog-grid">
            @foreach (var anime in Model.Animes)
            {
                <article class="anime-catalog-card" data-id="@anime.Id">
                    <div class="anime-catalog-card__cover">
                        <img src="@anime.Url" alt="Обложка: @anime.Name" width="480" height="720" loading="lazy" decoding="async">
                    </div>
                    <div class="anime-catalog-card__body">
                        <h3 class="mode-view anime-catalog-card__title">@anime.Name</h3>
                        <input value="" class="new-anime-name-input mode-edit link-select">
                    </div>
                </article>
            }
        </div>
    </section>


    <section class="section section-anime-catalog section-movie-catalog" id="anime-catalog" aria-labelledby="anime-catalog-title">
        <h2 class="section-title" id="anime-catalog-title">Каталог Фильмов</h2>
        <p class="section-intro">Обложки и названия — то, что уже в коллекции.</p>
        <div class="anime-catalog-grid">

            <article class="anime-catalog-card create-new-film" data-id="***">
                <div class="anime-catalog-card__cover">
                    <img src="***" alt="Обложка: ***" width="480" height="720" loading="lazy" decoding="async">
                </div>
                <div class="anime-catalog-card__body">
                    <input value="" class="movie-name-input link-select" placeholder="Movie name">
                    <input value="" class="movie-url-input link-select" placeholder="Movie cover url">
                    <button class="create-movie-button link-select">Create Movie</button>
                </div>
            </article>
            
            <article class="anime-catalog-card template" data-id="***">
                <div class="anime-catalog-card__cover">
                    <img src="***" alt="Обложка: ***" width="480" height="720" loading="lazy" decoding="async">
                </div>
                <div class="anime-catalog-card__body">
                    <h3 class="mode-view anime-catalog-card__title">***</h3>
                    <input value="" class="new-anime-name-input mode-edit link-select">
                </div>
            </article>

        </div>
    </section>

    <section class="section section-heroes" id="heroes" aria-labelledby="heroes-title">
        <h2 class="section-title" id="heroes-title">Персонажи</h2>
        <p class="section-intro">Иллюстрации и аниме, где персонаж числится в списке героев.</p>
        <p class="section-intro"><button class="remove-image link-button" disabled>remove</button></p>

        <div class="card-grid">
            @foreach (var girl in Model.AnimeGirls)
            {
                <article class="media-card" data-id="@girl.Id" data-likes="@girl.Likes">
                    <div class="media-card__img-wrap">
                        <img src="@girl.Url" alt="Персонаж @girl.Title" width="400" height="500" loading="lazy" decoding="async">
                    </div>
                    <div class="media-card__text">
                        <p class="media-card__name">@girl.Title</p>
                        <p class="media-card__likes">Лайки: @girl.Likes</p>
                        @if (!string.IsNullOrEmpty(girl.ConnectedAnimeTitles))
                        {
                            <p class="media-card__animes">@girl.ConnectedAnimeTitles</p>
                        }
                        @if (Model.CanDeleteGirl)
                        {
                            <p class="media-card__animes"><a class="delete-girl-link" href="/AnimeGirl/Delete?id=@girl.Id">Delete</a></p>
                        }
                    </div>
                </article>
            }
        </div>
    </section>

    <section class="section section-placeholder" id="games">
        <h2 class="section-title">Игры</h2>
        <div class="placeholder-box">
            <span class="placeholder-icon" aria-hidden="true">🎮</span>
            <p>Скоро добавлю список любимых игр и, может, пару скриншотов.</p>
        </div>
    </section>

    <section class="section section-placeholder" id="books">
        <h2 class="section-title">Книги</h2>
        <div class="placeholder-box">
            <span class="placeholder-icon" aria-hidden="true">📚</span>
            <p>Здесь появятся книги, которые хочется перечитывать и рекомендовать.</p>
        </div>
    </section>
</main>

<footer class="site-footer">
    <p>Сделано с теплом · 2026</p>
</footer>

<button type="button"
        class="anime-chat-toggle"
        aria-label="Открыть чат"
        aria-expanded="false"
        aria-controls="anime-chat-panel">
    💬
</button>

<aside id="anime-chat-panel" class="anime-chat-panel" aria-label="Чат">
    <div class="anime-chat-panel__header">
        <div>
            <h2 class="anime-chat-panel__title">Чат</h2>
            <span class="anime-chat-panel__user">Вы: …</span>
        </div>
        <button type="button" class="anime-chat-panel__close" aria-label="Закрыть чат">&times;</button>
    </div>
    <div class="anime-chat-messages" aria-live="polite"></div>
    <div class="anime-chat-toolbar">
        <button type="button" class="anime-chat-share" disabled>Поделиться</button>
    </div>
    <div class="anime-chat-input-box">
        <input type="text"
               class="anime-chat-input"
               placeholder="Сообщение…"
               maxlength="500"
               autocomplete="off">
        <button type="button" class="anime-chat-send">Отправить</button>
    </div>
</aside>

<template id="anime-chat-message-template">
    <div class="anime-chat-message">
        <div class="anime-chat-message__sender"></div>
        <div class="anime-chat-message__text"></div>
    </div>
</template>

<template id="anime-chat-share-card-template">
    <article class="anime-chat-share-card">
        <div class="anime-chat-share-card__img-wrap">
            <img class="anime-chat-share-card__img" alt="" width="120" height="150" loading="lazy" decoding="async">
        </div>
        <p class="anime-chat-share-card__title"></p>
        <p class="anime-chat-share-card__likes"></p>
    </article>
</template>
