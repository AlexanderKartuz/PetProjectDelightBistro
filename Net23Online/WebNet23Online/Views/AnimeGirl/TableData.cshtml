@using WebNet23Online.Models.AnimeGirl
@using WebNet23Online.Localizations
@model List<AnimeGirlImageInfoViewModel>
@{
    Layout = "_LayoutAnime";
}
<div>
    <select name="filter">
        <option value="">@AnimeGirl.TableData_NoFilter</option>
        <option value="more">@AnimeGirl.TableData_FilterMore</option>
        <option value="less">@AnimeGirl.TableData_FilterLess</option>
        <option value="eq">@AnimeGirl.TableData_FilterEqual</option>
    </select>
    <input name="valueForFilter" placeholder="@AnimeGirl.TableData_FilterValuePlaceholder" />
</div>
<div class="anime-grils">
    <div class="girl-row header">
        <div class="girl-cell"><a data-sort-by="Id" href="#">@AnimeGirl.TableData_ColumnId</a></div>
        <div class="girl-cell"><a data-sort-by="Name" href="#">@AnimeGirl.TableData_ColumnTitle</a></div>
        <div class="girl-cell"><a data-sort-by="" href="#">@AnimeGirl.TableData_ColumnConnectedAnime</a></div>
        <div class="girl-cell"><a data-sort-by="Url" href="#">@AnimeGirl.TableData_ColumnUrl</a></div>
    </div>
    @foreach (var item in Model)
    {
        <div class="girl-row">
            <div class="girl-cell">@item.Id</div>
            <div class="girl-cell">@item.Title</div>
            <div class="girl-cell">@item.ConnectedAnimeTitles</div>
            <div class="girl-cell">@item.Url</div>
        </div>
    }
</div>
