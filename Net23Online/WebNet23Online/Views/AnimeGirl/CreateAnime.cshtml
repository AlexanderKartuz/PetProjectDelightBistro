@using WebNet23Online.Models.AnimeGirl
@using WebNet23Online.Localizations
@model CreateAnimeViewModel
@{
    Layout = "_LayoutAnime";
}

<form method="post">
    <div>
        @Html.TextBoxFor(x => x.Name, new { placeholder = AnimeGirl.CreateAnime_NamePlaceholder })
    </div>
    <div>
        @Html.TextBoxFor(x => x.CoverUrl, new { placeholder = AnimeGirl.CreateAnime_CoverUrlPlaceholder })
    </div>
    <div>
        <button type="submit">@AnimeGirl.CreateAnime_Save</button>
    </div>
</form>
