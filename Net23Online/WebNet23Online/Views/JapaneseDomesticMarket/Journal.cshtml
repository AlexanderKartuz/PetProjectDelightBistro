@using WebNet23Online.Models.JapaneseDomesticMarket
@using WebNet23Online.Localizations
@model JournalPageViewModel
@{
    Layout = "_LayoutJapaneseDomesticMarket";
}
@section Scripts{
    <script src="~/js/japanese-domestic-market/journal.js"></script>
}
<div class="container-content">
    <article id="post-1" class="content-news">
        <div class="title-form">@JapaneseDomesticMarket.Journal_Header</div>
        <p>
            @JapaneseDomesticMarket.Journal_Welcome_Line
            <br>@JapaneseDomesticMarket.Journal_Text_Test_Models
            <br> <i>@JapaneseDomesticMarket.Journal_Text_Test_Models_h2</i>
            <div class="container-content">
                <img src="~/images/japanese-domestic-market/dynamo-photo1.jpg" class="img-content" />
                <img src="~/images/japanese-domestic-market/drift-photo1.jpg" class="img-content" />
                <img src="~/images/japanese-domestic-market/dynamo-photo4.jpg" class="img-content" />
            </div>
        </p>
        <div>
            @await Html.PartialAsync("_JournalJdmCommentPartial", Model.Posts.First(p => p.PostId == 1))
        </div>
    </article>

    <article id="post-2" class="content-news">
        <div class="title-form">@JapaneseDomesticMarket.Journal_Title_Header_Raubichi</div>
        <p class="date">@JapaneseDomesticMarket.Journal_Date_19_April</p>
        <p>
            @JapaneseDomesticMarket.Journal_Text_Raubichi_1
            <br>@JapaneseDomesticMarket.Journal_Text_Raubichi_2
        </p>
        <p>
            @JapaneseDomesticMarket.Journal_Text_Raubichi_3
        </p>
        <div class="container-content">
            <img src="~/images/japanese-domestic-market/raubichi-1.JPG" class="img-content" />
            <img src="~/images/japanese-domestic-market/raubichi-2.JPG" class="img-content" />
        </div>
        @await Html.PartialAsync("_JournalJdmCommentPartial", Model.Posts.First(p => p.PostId == 2))
    </article>


    <article id="post-3" class="content-news">
        <div class="title-form">@JapaneseDomesticMarket.Journal_Title_Header_2</div>
        <p class="date">@JapaneseDomesticMarket.Journal_Date_30_August</p>
        <p>
            @JapaneseDomesticMarket.Journal_Text_Lida_1
        </p>
    </article>
    <div class="container-content">
        <img src="~/images/japanese-domestic-market/lida-1.jpg" class="img-content" />
        <img src="~/images/japanese-domestic-market/lida-3.jpg" class="img-content" />
        <img src="~/images/japanese-domestic-market/lida-2.jpg" class="img-content" />
    </div>
    @await Html.PartialAsync("_JournalJdmCommentPartial", Model.Posts.First(p => p.PostId == 3))
    <div class="pop-up">
        <span>&times;</span>
        <img src="" alt="" />
    </div>
</div>