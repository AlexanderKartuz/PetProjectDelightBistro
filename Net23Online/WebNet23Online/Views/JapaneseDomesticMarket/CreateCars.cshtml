@using WebNet23Online.Models.JapaneseDomesticMarket
@using WebNet23Online.Localizations
@model JapaneseDomesticMarketViewModels
@{
    Layout = "_LayoutJapaneseDomesticMarket";
}
@section Scripts{
    <script src="~/js/japanese-domestic-market/create-cars.js"></script>
}

<div class="feeadback-container-box">
    <div class="feedback-container">
        <form asp-controller="JapaneseDomesticMarket" asp-action="CreateCars" method="post" enctype="multipart/form-data">
            <div> <label>@JapaneseDomesticMarket.CreateCars_Manufacturer</label></div>
            <div>
                @Html.DropDownListFor(x => x.ManufactureId, Model.AllManufacturer)
            </div>
            <div> <label>@JapaneseDomesticMarket.CreateCars_Brand</label></div>
            <div>
                @Html.TextBoxFor(x => x.Marka, new { type = "text" })
                @Html.ValidationMessageFor(x => x.Marka)
            </div>
            <div> <label>@JapaneseDomesticMarket.CreateCars_Model</label></div>
            <div>
                @Html.TextBoxFor(x => x.Model, new { type = "text" })
                @Html.ValidationMessageFor(x => x.Model)
            </div>
            <div><label>Цена</label></div>
            <div>
                @Html.TextBoxFor(x => x.Price, new { type = "number", placeholder = "" })
            </div>
            <div class="title-form">@JapaneseDomesticMarket.CreateCars_Attach_Photo</div>
            <div>
                @Html.TextBoxFor(x => x.Url, new { type = "url", placeholder = "URL" })
            </div>
            <div><label>@JapaneseDomesticMarket.CreateCars_Headers_Vehicle_Inspection_History</label></div>
            <div>
                <input asp-for="VehicleInspectionHistoryUrl" type="file" accept=".txt" />
            </div>
            <button type="submit" class="link-button">@JapaneseDomesticMarket.CreateCars_Send_Button</button>
        </form>
    </div>
    <div class="feedback-container">
    <div class="cars-card" id="car-preview">
        <div class="card-title"><span id="preview-title">***</span></div>
        <div class="card-photo"><img id="preview-img" src="" alt="" /></div>
        <div class="auto-card-price" id="preview-price">***</div>
    </div>
    </div>
</div>