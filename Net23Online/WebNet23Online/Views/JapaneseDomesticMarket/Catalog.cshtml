@using WebNet23Online.Models.JapaneseDomesticMarket
@using WebNet23Online.Localizations
@model CatalogCarsPermissionViewModel
@{
    Layout = "_LayoutJapaneseDomesticMarket";
}
@section Scripts{
    <script src="~/js/japanese-domestic-market/createJdmMerch.js"></script>
}

<div class="container">
    @foreach (var manufacture in Model.CatalogAuto)
    {
        <div class="one-category-auto">
            <div class="auto-card-title">
                @manufacture.ManufacturerType
            </div>
            <div class="container-card-box">
                @foreach (var jdmItem in manufacture.CarsJDMItems)
                {
                    <div class="cars-card">
                        <div class="card-title">
                            @jdmItem.Marka @jdmItem.Model
                        </div>
                        <div class="card-photo ">
                            <img src=@jdmItem.Url alt=@jdmItem.Marka />
                        </div>
                        <div class="auto-card-price">
                            @jdmItem.Price
                        </div>
                        <div><button class="btn-watch ">@JapaneseDomesticMarket.Catalog_Button_More_Details</button></div>
                    </div>
                }
            </div>
        </div>
    }
</div>

@if (Model.CarsWithoutInspection.Any())
{
    <section class="container">
        <h2>@JapaneseDomesticMarket.Catalog_Statistics_VehicalHistory</h2>
        <ul>
            @foreach (var row in Model.CarsWithoutInspection)
            {
                <li>@row.Manufacturer — @row.CountCars</li>
            }
        </ul>
    </section>
}
<div class="container-title"><h2>@JapaneseDomesticMarket.Catalog_header_catalog_product</h2></div>
<div class="merch-container">
    <section class="jdm-merch-container">
        <div class="product-card create-new-jdm-merch" id="product-card">
            <input value="" class="new-jdm-merch-input new-jdm-merch-name" placeholder="Name" />
            <input value="" class="new-jdm-merch-input new-jdm-merch-description" placeholder="description" />
            <input value="" class="new-jdm-merch-input new-jdm-merch-price" placeholder="price" />
            <input value="" class="new-jdm-card-picture" placeholder="pictureUrl" />
            <button class="button-create-new-jdm-merch">@JapaneseDomesticMarket.Catalog_button_add_merch</button>
        </div>
</section>
    <section class="jdm-merch-container">
        <div class="jdm-merch">
            <div class="product-card template" id="product-card">
                <div class="product-card-title" id="product-card-title">***</div>
                <div class="product-card-description" id="product-card-description">***</div>
                <div class="product-card-price" id="product-card-price">***</div>
                <div class="product-card-picture" id="product-card-picture"><img src="***" class="product-card-picture" /></div>
            </div>
        </div>
    </section>
</div>