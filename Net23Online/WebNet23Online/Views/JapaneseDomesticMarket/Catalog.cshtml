@using WebNet23Online.Models.JapaneseDomesticMarket
@using WebNet23Online.Localizations
@model CatalogCarsPermissionViewModel
@{
    Layout = "_LayoutJapaneseDomesticMarket";
}

<div class="container">
    @foreach (var manufacture in Model.CatalogAuto)
    {
        <div class="one-category-auto">
            <div class="auto-card-title">
                @manufacture.ManufacturerType
            </div>
            <div class="container-card-box">
                @foreach (var jdmItem in manufacture.CarsJDMItems)
                {
                    <div class="cars-card">
                        <div class="card-title">
                            @jdmItem.Marka @jdmItem.Model
                        </div>
                        <div class="card-photo ">
                            <img src=@jdmItem.Url alt=@jdmItem.Marka />
                        </div>
                        <div class="auto-card-price">
                            @jdmItem.Price
                        </div>
                        <div><button class="btn-watch ">@JapaneseDomesticMarket.Catalog_Button_More_Details</button></div>
                    </div>
                }
            </div>
        </div>
    }
</div>

@if (Model.CarsWithoutInspection.Any())
{
    <section class="container">
        <h2>@JapaneseDomesticMarket.Catalog_Statistics_VehicalHistory</h2>
        <ul>
            @foreach (var row in Model.CarsWithoutInspection)
            {
                <li>@row.Manufacturer — @row.CountCars</li>
            }
        </ul>
    </section>
}