@model WebNet23Online.Models.RockLegendsPortal.CreateGenreViewModel
@{
    Layout = "_LayoutRockLegends";
}
<link rel="stylesheet" href="/css/rock-legends-portal/style.css">

<div class="main-container">
    <div class="content-wrapper" style="justify-content: center;">
        <div class="poll-container" style="width: 100%; max-width: 500px;">
            <h2>Добавить новый жанр</h2>
            <form asp-action="AddGenre" method="post" enctype="multipart/form-data">
                <div class="poll-controls" style="flex-direction: column; gap: 15px;">
                    <input asp-for="Name" class="form-control" placeholder="Название жанра (например, Heavy Metal)" required />
                    <span asp-validation-for="Name" style="color: #ff4d4d; font-size: 0.9em; text-align: left;"></span>
                    
                    <div style="text-align: left; width: 100%;">
                        <label style="color: #ccc; margin-bottom: 5px; display: block;">Обложка жанра:</label>
                        <input type="file" asp-for="Image" class="form-control" accept="image/*" />
                    </div>

                    <input asp-for="CoverUrl" class="form-control" placeholder="Или укажите URL обложки вручную" />
                    
                    <button type="submit" class="poll-button">Сохранить жанр</button>
                </div>
            </form>
        </div>
    </div>
</div>