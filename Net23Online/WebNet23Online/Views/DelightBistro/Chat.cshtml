@using WebNet23Online.Models.DelightBistro;

@{
    Layout = "_LayoutDelightBistro";
}

@section Scripts {
    <script src="/js/delight-bistro/delight-bistro-chat-hub.js"></script>
    <link rel="stylesheet" href="/css/delight-bistro/chat.css" />
}
<div class="main-container">
    <div class="chat-container">
        <div class="sidebar">
            <div class="current-user">You: Current User Name</div>
            <div class="user-box">
                <div class="user-list">
                    @*<div class="chat-user">
                        <div class="user-name">User 1</div>
                    </div> *@
                </div>
            </div>
        </div>
    </div>

    <div class="chat-room hiden">

        <div class="chat-room-messages">

            @* <div class="message sent">
                <div class="message-sender">Me Test1</div>
                <div class="message-text">Message Test1</div>
            </div>

            <div class="message recived">
                <div class="message-sender">Anna Test1</div>
                <div class="message-text">Message Test2</div>
            </div> *@

        </div>

        <div class="chat-input-box">
            <input type="text" name="message" class="message-input" placeholder="Введите сообщение..." />
            <button type="button" class="btn-send-message">Отправить</button>
        </div>
    </div>

</div>

