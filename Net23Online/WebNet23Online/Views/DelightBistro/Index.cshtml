@using WebNet23Online.Models.DelightBistro;
@using WebNet23Online.Localizations;
@model List<MenuTypeViewModel>

@{
    Layout = "_LayoutDelightBistro";
}

@section Scripts {
    <link rel="stylesheet" href="/css/delight-bistro/style.css" />

    <script src="/js/delight-bistro/buy-button.js"></script>
    <script src="/js/delight-bistro/tea.js"></script>
    <script src="/js/delight-bistro/delight-bistro-hub.js"></script>
}

<header class="head-menu">
    <div class="logo-container">
        <div class="logo">
            <img src="/images/delight-bistro/logo.png" alt="logo" />
        </div>
        <div class="logo-name">Logo name</div>
    </div>
    <div class="main-info center">
        <div class="head-menu-item">Info</div>
        <div class="head-menu-item">Head menu</div>
        <button type="button" class="head-menu-item tea-form-toggle">Режим админа</button>
    </div>
</header>
<div class="notifications"></div>
<div class="order-box hidden">
    Заказать блюда:
    <div>
        Выбрано блюд:
    </div>
    <div class="counter-display">0</div>
    <ul id="orderList">
        <li class="order-food-item">Selected FoodItem</li>
    </ul>
    <div class="total-price">Общая цена</div>
    <button id="post-order-btn">Оформить заказ</button>
</div>
<div id="order-success" class="order-success hidden">
    <div id="order-success-message"></div>
    <div id="order-success-order-id"></div>
    <div id="order-success-time"></div>
    <div id="order-success-price"></div>
</div>

<h1 class="center">@DelightBistro.Index_Cuisine</h1>

<div class="layout">
    <div class="plate">

        @foreach (var category in Model)
        {
            if ((category.FoodItems).Any())
            {
                <div class="type-of-food">
                    <div class="type-name center">
                        @category.Name @if(category.Creator!=null) {
                        <div> (Creator: @category.Creator)</div>
                    }
                </div>
                <div class="menu">
                    @foreach (var foodItem in category.FoodItems)
                    {
                        <div class="food-item" item-id="@foodItem.Id">
                            @if (foodItem.Creator != null)
                            {
                                <div> Creator: @foodItem.Creator</div>
                            }

                            <div class="image-container">
                                <a href="\DelightBistro\FoodBuilderData?id=@foodItem.Id"><img src="@foodItem.ImgURL" alt="@foodItem.Name" /></a>
                            </div>
                            <div class="name-price-btn">
                                <div class="name-price">
                                    <div class="food-name">@foodItem.Name</div>
                                    <div class="price">@foodItem.Price р</div>
                                </div>
                                <div class="btnright">
                                    <button data-food-item-id="@foodItem.Id"
                                            data-food-item-price="@foodItem.Price"
                                            class="buy-button add-button colorbtn">
                                        +
                                    </button>
                                </div>
                            </div>
                            <div class="recept">
                                <ul>
                                    @if (foodItem.IngredientsList is not null)
                                    {
                                        @foreach (var ingredient in foodItem.IngredientsList)
                                        {
                                            <li>@ingredient.Name @ingredient.Quantity gr.</li>
                                        }
                                    }
                                </ul>
                            </div>
                        </div>
                    }
                </div>
            </div>
        }

       
    }

    <div class="type-of-food">
        <div class="type-name center">Teas</div>

        <div class="menu">
            <div class="create-tea-form food-item hidden">
                <div>Создание нового чая</div>
                <input type="text" class="tea-name-input input-box" placeholder="Название чая" />
                <input type="number" class="tea-price-input input-box" placeholder="Цена" />
                <button type="button" class="create-button input-box">Добавить чай</button>
            </div>
            <div class="teas-catalog">

                @* <div class="food-item" data-item-id="***">

                    <div class="image-container"></div>
                <div class="name-price-btn">
                    <div class="name-price">
                        <div class="food-name">="***"></div>
                        <div class="price">="***"> р</div>
                    </div>
                    <div class="btnright">
                        <button data-food-item-id="="***">"
                                data-food-item-price="="***">"
                                class="buy-button add-button colorbtn">
                            +
                        </button>
                    </div>
                </div>

                </div> *@
            </div>
        </div>

    </div>
</div>

<aside class="right-bar">
    <div class="form-field">
        <form method="post">
            <div class="userName">Username</div>
            <input type="text"
                   name="username"
                   placeholder="Введите логин"
                   required />

            <div>Password</div>
            <input type="password"
                   name="userPassword"
                   placeholder="Введите пароль"
                   required />
            <button type="submit">Войти</button>
        </form>
    </div>

    <ul class="navigation">
        <li><a href="\DelightBistro\Index">@DelightBistro.Index_All_menu</a> </li>

        @foreach (var menu in Model)
        {
            <li><a href="\DelightBistro\Index?menutype=@menu.Name">@menu.Name</a> </li>

        }
        <br>

        <br>
        <li><a href="\DelightBistro\CreateMenu" data-test="create-menu">@DelightBistro.Index_Create_menu</a> </li>
        <li><a href="\DelightBistro\CreateIngredient" data-test="create-ingredient">@DelightBistro.Index_Create_ingredient</a> </li>
        <li><a href="\DelightBistro\FoodBuilderData" data-test="food-builder">@DelightBistro.Index_Create_dish</a> </li>
        <br>
        <li><a href="\DelightBistro\AllFoodItems" data-test="all-foods">@DelightBistro.Index_All_dish</a> </li>
        <li><a href="\DelightBistro\Stats">Stats</a> </li>

    </ul>
</aside>
</div>
</div>

