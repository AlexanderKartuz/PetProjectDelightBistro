@using WebNet23Online.Models.DelightBistro;

@{
    Layout = "_LayoutDelightBistro";
}
@model CreateFoodItemViewModel

@section Scripts {
    <script src="/js/delight-bistro/preview-food-item.js"></script>

    <link rel="stylesheet" href="/css/delight-bistro/style.css" />
}


<div class="create-food-box">
    <div class="form-title">
        Добавьте блюдо. Заполните все поля в форме
    </div>
    @if (Model.Id > 0)
    {
        <div class="change-food">
            <div class="change-food">
                <img src=@Model.ImgURL alt=@Model.Name />
            </div>
        </div>
    }

    <div class="preview food-item">
        <div> Preview</div>
        <div class="preview-box">
            <div>
                <div class="preview-image-container">
                    <img src="" alt="image" />
                </div>
                <div class="name-price">
                    <div class="name-price">
                        <div class="preview-menu-name">Menu</div>
                        <div class="preview-food-name">Name</div>
                        <div class="preview-price">Price</div>
                    </div>
                    <div class="preview-recept">
                        <ul>
                            <li>Ингредиенты и количество</li>
                        </ul>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <form method="post" enctype="multipart/form-data">
        <div class="input-box">
           
            <div>Название блюда</div>
            @Html.TextBoxFor(x => x.Name, new { type = "text", required = "required", placeholder = "Имя блюда" })
            @Html.ValidationMessageFor(x => x.Name)

        </div>
        <div class="input-box">
            <div>Цена блюда</div>
            @Html.TextBoxFor(x => x.Price, new { type = "number", required = "required", placeholder = "Стоимость" })
            @Html.ValidationMessageFor(x => x.Price)
        </div>
        <div class="input-radio-box">
            <div class="radio-box-title">
                Выберите тип меню
            </div>
            <div class="radio-box-container">
                <div class="radio-box">
                    @Html.DropDownListFor(x => x.MenuId, Model.Menus, "Выберите меню")

                </div>
                
            </div>
            <div class="input-box">
                <div>
                    Выберите ингредиенты
                </div>
                @for (var i = 0; i < Model.IngredientsList.Count; i++)
                {
                    <div>
                        @Html.HiddenFor(x => x.IngredientsList[i].Id)
                        @Html.HiddenFor(x => x.IngredientsList[i].Name)
                        <label>@Model.IngredientsList[i].Name</label>
                        @Html.CheckBoxFor(x => x.IngredientsList[i].IsSelected)
                        @Html.TextBoxFor(x => x.IngredientsList[i].Quantity
                            , new
                            {
                                type = "number"
                                ,
                                min = "1"
                                ,
                                placeholder = "Граммы"
                            })
                        @Html.ValidationMessageFor(x => x.IngredientsList[i].Name)

                           
                    </div>
                }

            </div>
        </div>
        
        <div class="input-box url-box">
            <div class="input-box url-box">
                <input type="file" name="Image" />
            </div>
            @Html.TextBoxFor(x => x.ImgURL, new { type = "string", placeholder = "Добавьте URL изображения" })
            @Html.ValidationMessageFor(x => x.ImgURL)
        </div>
        <div class="food-create-button"><button type="submit">Добавить блюдо</button></div>
    </form>

</div>