@using WebNet23Online.Localizations.HabitTracker
@{
    Layout = "_LayoutHabitTracker";
}

<link rel="stylesheet" href="/css/habit-tracker/settings.css">

<div class="settings-wrap">
    <h2 class="settings-title">@HabitTracker.Settings_title</h2>
    <p class="settings-sub">@HabitTracker.Settings_subtitle</p>

    <div class="settings-grid">
        <div class="s-card">
            <div class="s-icon add">➕</div>
            <div>
                <div class="s-label">@HabitTracker.Settings_add_label</div>
                <div class="s-desc">@HabitTracker.Settings_add_desc</div>
            </div>
            <a asp-action="CreateHabit" class="s-btn add">@HabitTracker.Settings_add_btn</a>
        </div>

        <div class="s-card">
            <div class="s-icon del">🗑️</div>
            <div>
                <div class="s-label">@HabitTracker.Settings_del_label</div>
                <div class="s-desc">@HabitTracker.Settings_del_desc</div>
            </div>
            <a asp-action="DeleteHabit" class="s-btn del">@HabitTracker.Settings_del_btn</a>
        </div>

        <div class="s-card">
            <div class="s-icon edit">🖊️</div>
            <div>
                <div class="s-label">@HabitTracker.Settings_edit_label</div>
                <div class="s-desc">@HabitTracker.Settings_edit_desc</div>
            </div>
            <a asp-action="EditHabit" class="s-btn edit">@HabitTracker.Settings_edit_btn</a>
        </div>
        
        <div class="s-card">
            <div class="s-icon report">#</div>
            <form method="post" asp-controller="HabitTracker" asp-action="GenerateReport">
                <button class="s-label">Сохранить отчет выполнения привычек</button>
            </form>
        </div>
    </div>
</div>
