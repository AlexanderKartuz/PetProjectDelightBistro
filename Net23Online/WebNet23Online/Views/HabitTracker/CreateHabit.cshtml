@using WebNet23Online.Models.HabitTracker
@using WebNet23Online.Localizations.HabitTracker
@model HabitViewModel

@{
    Layout = "_LayoutHabitTracker";
}

<link rel="stylesheet" href="/css/habit-tracker/settings.css">

<div class="tracker">
    <div class="tracker-title">@HabitTracker.CreateHabit_title</div>

    <div class="settings-container">

        <div class="settings-card">
            <div class="settings-card-header">
                <span class="settings-icon">＋</span>
                <h3>@HabitTracker.CreateHabit_card_title</h3>
            </div>

            <form method="post">
                @Html.HiddenFor(x => x.UserId)
                <div class="form-group">
                    <label>@HabitTracker.CreateHabit_label_title</label>
                    <div>
                        @Html.TextBoxFor(x => x.Title, new { placeholder = HabitTracker.CreateHabit_placeholder_title, type = "text" })
                        @Html.ValidationMessageFor(x => x.Title)
                    </div>
                </div>

                <div class="form-group">
                    <label>@HabitTracker.CreateHabit_label_goal</label>
                    <div>
                        @Html.TextBoxFor(x => x.MonthGoal, new { type = "number", placeholder = HabitTracker.CreateHabit_placeholder_goal, @class = "input-field" })
                        @Html.ValidationMessageFor(x => x.MonthGoal)
                    </div>
                </div>

                <button type="submit" class="btn-action btn-add">@HabitTracker.CreateHabit_btn_submit</button>
            </form>

        </div>
    </div>
</div>

@section Scripts
{
    <script src="/js/habit-tracker/settings.js"></script>

    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
