@using WebNet23Online.Models.HabitTracker
@using WebNet23Online.Localizations.HabitTracker
@{
    Layout = "_LayoutHabitTracker";
}

<link rel="stylesheet" href="/css/habit-tracker/welcome.css">

<div class="welcome-page">

    <!-- Hero секция -->
    <header class="welcome-hero">
        <div class="hero-content">
            <div class="hero-left">
                <h1 class="hero-title">
                    @HabitTracker.Index_hero_title
                </h1>
                <p class="hero-subtitle">
                    @HabitTracker.Index_hero_subtitle
                </p>
                <div class="hero-buttons">
                    <a href="@Url.Action("HabitTracker", "HabitTracker")" class="btn-primary">@HabitTracker.Index_btn_primary</a>
                    <a href="#features" class="btn-secondary">@HabitTracker.Index_btn_secondary</a>
                </div>
            </div>

            <div class="hero-visual">
                <div class="mockup">
                    <img src="/images/habit-tracker/habit-mockup.png" alt="Habit Tracker Preview" class="mockup-img">
                </div>
            </div>
        </div>
    </header>

    <!-- Особенности -->
    <section id="features" class="features-section">
        <div class="section-header">
            <h2>@HabitTracker.Index_features_title</h2>
            <p>@HabitTracker.Index_features_subtitle</p>
        </div>

        <div class="features-grid">

            <div class="feature-card">
                <div class="feature-icon">📅</div>
                <h3>@HabitTracker.Index_feature1_title</h3>
                <p>@HabitTracker.Index_feature1_desc</p>
            </div>

            <div class="feature-card">
                <div class="feature-icon">📊</div>
                <h3>@HabitTracker.Index_feature2_title</h3>
                <p>@HabitTracker.Index_feature2_desc</p>
            </div>

            <div class="feature-card">
                <div class="feature-icon">📖</div>
                <h3>@HabitTracker.Index_feature3_title</h3>
                <p>@HabitTracker.Index_feature3_desc</p>
            </div>

            <div class="feature-card">
                <div class="feature-icon">✨</div>
                <h3>@HabitTracker.Index_feature4_title</h3>
                <p>@HabitTracker.Index_feature4_desc</p>
            </div>

            <div class="feature-card">
                <div class="feature-icon">🗑️</div>
                <h3>@HabitTracker.Index_feature5_title</h3>
                <p>@HabitTracker.Index_feature5_desc</p>
            </div>

            <div class="feature-card">
                <div class="feature-icon">🎨</div>
                <h3>@HabitTracker.Index_feature6_title</h3>
                <p>@HabitTracker.Index_feature6_desc</p>
            </div>

        </div>
    </section>

    <!-- Как это работает -->
    <section class="how-it-works">
        <div class="section-header">
            <h2>@HabitTracker.Index_how_title</h2>
        </div>

        <div class="steps">
            <div class="step">
                <div class="step-number">01</div>
                <div class="step-content">
                    <h3>@HabitTracker.Index_step1_title</h3>
                    <p>@HabitTracker.Index_step1_desc</p>
                </div>
            </div>
            <div class="step">
                <div class="step-number">02</div>
                <div class="step-content">
                    <h3>@HabitTracker.Index_step2_title</h3>
                    <p>@HabitTracker.Index_step2_desc</p>
                </div>
            </div>
            <div class="step">
                <div class="step-number">03</div>
                <div class="step-content">
                    <h3>@HabitTracker.Index_step3_title</h3>
                    <p>@HabitTracker.Index_step3_desc</p>
                </div>
            </div>
        </div>
    </section>

    <!-- Призыв к действию -->
    <section class="cta-section">
        <div class="cta-content">
            <h2>@HabitTracker.Index_cta_title</h2>
            <p>@HabitTracker.Index_cta_subtitle</p>
            <a href="@Url.Action("HabitTracker", "HabitTracker")" class="btn-primary large">@HabitTracker.Index_cta_btn</a>
        </div>
    </section>

</div>
