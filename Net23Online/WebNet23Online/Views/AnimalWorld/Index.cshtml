@using WebNet23Online.Localizations
@model WebNet23Online.Models.AnimalWorld.StartPageAnimalWorldInfoViewModel
@{
    Layout = "_LayoutAnimalWorld";
}

@section Scripts {
    <script src="~/js/animal-world/index.js"></script>
}

<title>@AnimalWorld.AnimalWorldTitle</title>

<div class="main-place">
    <div class="green-title">
        <h2>@AnimalWorld.AboutPlanet</h2>
    </div>
    <hr class="green-line">
    <p>@AnimalWorld.IndexDescription</p>
    <div class="image-container">
        <img src="~/images/animal-world/animals.jpg" />
    </div>
    <div class="green-title">
        <h2>@AnimalWorld.AnimalFamilies</h2>
    </div>
    <hr class="green-line">
    @if (Model.AnimalFamilies.Any())
    {
        <button id="delete-selected-btn" class="btn btn-danger mb-3">@AnimalWorld.DeleteSelected</button>
        <div class="entity-grid" data-empty-text="@AnimalWorld.NoAnimalFamilies">
            @foreach (var family in Model.AnimalFamilies)
            {
                <div class="animal entity-card js-family-card">
                    <h3>@family.AnimalFamilyName</h3>
                    <p>@family.Description</p>
                </div>
            }
        </div>
    }
    else
    {
        <p class="empty-list-note">@AnimalWorld.NoAnimalFamilies</p>
    }

    <div class="green-title">
        <h2>@AnimalWorld.AnimalSpecies</h2>
    </div>
    <hr class="green-line">
    @if (Model.AnimalSpecies.Any())
    {
        @foreach (var species in Model.AnimalSpecies)
        {
            <div class="animal animal-card entity-card">
                <div class="entity-image">
                    <img src="@species.Url" />
                </div>
                <div>
                    <h3>@species.AnimalSpeciesName</h3>
                    <p><strong>@AnimalWorld.Habitat: </strong>@species.NativeRange</p>
                    <p>@species.Description</p>
                    @if (species.Zoos.Any())
                    {
                        <p><strong>@AnimalWorld.Zoos: </strong>@string.Join(", ", species.Zoos)</p>
                    }
                </div>
            </div>
        }
    }
    else
    {
        <p class="empty-list-note">@AnimalWorld.NoAnimalSpecies</p>
    }

    <div class="green-title">
        <h2>Случайные животные</h2>
    </div>
    <hr class="green-line">
    @if (Model.RandomAnimals.Any())
    {
        <div class="random-animals-container">
            @foreach (var randomAnimal in Model.RandomAnimals)
            {
                <div class="random-animal-card">
                    <div class="random-animal-image">
                        <img src="@randomAnimal.Image" />
                    </div>
                    <div class="random-animal-fact">
                        <p>@randomAnimal.Fact</p>
                    </div>
                </div>
            }
        </div>
    }
    else
    {
        <p class="empty-list-note">Что-то пошло не так и загрузить изображения не удалось.</p>
    }
</div>