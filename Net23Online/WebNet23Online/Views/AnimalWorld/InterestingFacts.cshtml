@{
    Layout = "_LayoutAnimalWorld";
}

@section Scripts {
    <script src="~/js/animal-world/animal-species-facts.js"></script>
}

<title>Интересные факты</title>

<div class="main-place">
    <h2 class="green-title page-title">Факты о животных</h2>
    <div class="green-line"></div>

    <div class="facts-form-container">
        <div class="form-group">
            <label for="animal-type-select" class="form-label">Вид животного:</label>
            <select id="animal-type-select" class="form-input">
                <option>Загрузка...</option>
            </select>
        </div>

        <div class="form-group">
            <label for="factText" class="form-label">Текст факта:</label>
            <textarea id="factText" class="form-input comment-textarea" rows="4" placeholder="Введите интересный факт..."></textarea>
        </div>

        <div class="find-animal align-items-center">
            <button type="button" id="addFactBtn" class="find-animal-button">Добавить факт</button>
            <span id="fact-form-feedback" class="zoo-name-feedback"></span>
        </div>
    </div>

    <h3 class="green-title section-title">Известные факты</h3>
    <div class="green-line"></div>

    <div id="facts-container" class="facts-list">
        <p class="empty-list-note" id="facts-loading-status">Загрузка фактов...</p>
    </div>
</div>