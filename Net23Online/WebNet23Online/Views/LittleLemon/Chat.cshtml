@using WebNet23Online.Models.LittleLemon
@model LittleLemonChatPageViewModel

@{
	Layout = "_LayoutLittleLemon";
	ViewData["Title"] = "Support Chat";
}
@section Scripts {
	<link rel="stylesheet" href="/css/little-lemon/chat.css" />
	<script src="/js/little-lemon/little-lemon-chat.js"></script>
}

<section class="chat-page"
		 data-user-id="@Model.UserId"
		 data-user-name="@Model.UserName"
		 data-is-admin="@Model.IsAdmin">
	<h2 class="chat-title">Support Chat</h2>

	<div class="chat-messages" aria-live="polite"></div>

	@if (Model.IsAdmin)
	{
		<div class="chat-admin-controls">
			<label class="chat-target-user-label" for="chat-target-user-id">
				Reply to user ID:
			</label>
			<input type="number"
				   id="chat-target-user-id"
				   class="chat-target-user-id"
				   min="1"
				   step="1" />
		</div>
	}

	<div class="chat-input-box">
		<input type="text"
			   class="chat-input"
			   placeholder="Type your message..."
			   autocomplete="off" />
		<button type="button" class="chat-send">Send</button>
	</div>

	<template id="chat-message-template">
		<div class="message">
			<div class="message-sender" data-field="sender"></div>
			<div class="message-text" data-field="text"></div>
		</div>
	</template>
</section>

