@using WebNet23Online.Models.LittleLemon
@using WebNet23Online.Localizations
@model LittleLemonReservationPageViewModel
@{
	Layout = "_LayoutLittleLemon";
}
@section Scripts {
	<script src="/js/little-lemon/reservation.js"></script>
}
<title>@LittleLemon.Reservation_PageTitle</title>
@Html.Partial("_LittleLemonHeroSection", Model.Hero!)

<section class="booking-section">
	<h2>@LittleLemon.Reservation_Header</h2>


	<form class="booking-form" method="post" enctype="multipart/form-data" asp-controller="LittleLemon"
		  asp-action="Reservation">
		<div asp-validation-summary="All" class="booking-validation-summary"></div>
		<div>
			<label for="guest-name">@LittleLemon.Reservation_GuestName</label>
			<input type="text" id="guest-name" asp-for="Reservation.GuestName" required />
			<span asp-validation-for="Reservation.GuestName" class="field-validation-error"></span>
		</div>
		<div>

			<label for="reserve-date">@LittleLemon.Reservation_ChooseDate</label>
			<input type="date" id="reserve-date" asp-for="Reservation.ReservationDateOnly" required />
			<span asp-validation-for="Reservation.ReservationDateOnly" class="field-validation-error"></span>
		</div>
		<div>
			<label for="reserve-time">@LittleLemon.Reservation_ChooseTime</label>
			<select id="reserve-time" asp-for="Reservation.AvailableTimesOnly" required>
				<option value="17:00">17:00</option>
				<option value="18:00">18:00</option>
				<option value="19:00">19:00</option>
				<option value="20:00">20:00</option>
				<option value="21:00">21:00</option>
				<option value="22:00">22:00</option>
			</select>
			<span asp-validation-for="Reservation.AvailableTimesOnly" class="field-validation-error"></span>
		</div>
		<div>
			<label for="guests">@LittleLemon.Reservation_NumberOfGuests</label>
			<input type="number" min="1" max="10" id="guests" asp-for="Reservation.NumberOfGuests" required />
			<span asp-validation-for="Reservation.NumberOfGuests" class="field-validation-error"></span>
		</div>
		<div>
			<label for="seating">@LittleLemon.Reservation_SeatingPreference</label>
			<select id="seating" asp-for="Reservation.SeatingPreference" required>
				<option value="no-preference">@LittleLemon.Reservation_NoPreference</option>
				<option value="indoor">@LittleLemon.Reservation_Indoor</option>
				<option value="patio">@LittleLemon.Reservation_Patio</option>
				<option value="window">@LittleLemon.Reservation_Window</option>
			</select>
			<span asp-validation-for="Reservation.SeatingPreference" class="field-validation-error"></span>
		</div>
		<div>
			<label for="occasion">@LittleLemon.Reservation_Occasion</label>
			<div>
				<select id="occasion" asp-for="Reservation.Occasion" required>
					<option value="none">@LittleLemon.Reservation_Occasion_None</option>
					<option value="birthday">@LittleLemon.Reservation_Occasion_Birthday</option>
					<option value="anniversary">@LittleLemon.Reservation_Occasion_Anniversary</option>
					<option value="other">@LittleLemon.Reservation_Occasion_Other</option>
				</select>
				<span asp-validation-for="Reservation.Occasion" class="field-validation-error"></span>
			</div>

		</div>
		<div>
			<label for="text-area"> @LittleLemon.Reservation_ExtraLabel </label>
			<textarea asp-for="Reservation.UserComments" id="text-area" cols="2" rows="3"
					  placeholder="@LittleLemon.Reservation_CommentsPlaceholder" required></textarea>
			<span asp-validation-for="Reservation.UserComments" class="field-validation-error"></span>
		</div>
		<div>
			<label asp-for="DessertReferencePhoto">@LittleLemon.Reservation_DessertPhoto</label>
			<input type="file" asp-for="DessertReferencePhoto" accept="image/jpeg,image/png,image/webp" />
			<span asp-validation-for="DessertReferencePhoto" class="field-validation-error"></span>
		</div>
		<div class="image-preview_container hide">
			<div class="image-preview_image__wrapper">
				<div class="image-preview_btn"><i>X</i></div>
				<img src="" alt="Reservation Preview" class="image-preview_image" />
			</div>

		</div>
		<input type="submit" value="@LittleLemon.Reservation_Submit" class="btn" />
	</form>

</section>
