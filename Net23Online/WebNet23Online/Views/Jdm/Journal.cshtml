@using WebNet23Online.Models.Jdm
@using WebNet23Online.Localizations
@model JournalPageViewModel
@{
    Layout = "_LayoutJdm";
}
@section Scripts{
    <script src="~/js/japanese-domestic-market/journal.js"></script>
}

<div class="jdm-page-intro">
    <h1>@JapaneseDomesticMarket.Layout_Journal</h1>
    <p>ジャーナル — новости и обзоры</p>
</div>

<div class="container-content">
    <form asp-action="DeleteOldPosts" method="post">
        <button type="submit" class="delete-comments">@JapaneseDomesticMarket.Journal_button_delete_post</button>
    </form>
    <div class="container-content">
        <article class="content-news">
            <div class="title-form">@JapaneseDomesticMarket.Journal_Header</div>
            <p>
                @JapaneseDomesticMarket.Journal_Welcome_Line
                <br>@JapaneseDomesticMarket.Journal_Text_Test_Models
                <br> <i>@JapaneseDomesticMarket.Journal_Text_Test_Models_h2</i>
                <div class="container-content">
                    <img src="~/images/japanese-domestic-market/dynamo-photo1.jpg" class="img-content" />
                    <img src="~/images/japanese-domestic-market/dynamo-photo4.jpg" class="img-content" />
                </div>
            </p>
            
        </article>
    </div>

        <div class="pop-up">
            <span>&times;</span>
            <img src="" alt="" />
        </div>
    </div>

<div class="container-content">
        @foreach (var post in Model.Posts)
        {
            <article id="post-@post.PostId" class="content-news">
                <div class="title-form">@post.Title</div>
                @if (post.PublishedDate.HasValue)
                {
                    <p class="date">@post.PublishedDate.Value.ToString("d MMMM yyyy")</p>
                }
                <img src="@post.UrlPicture" />
                @await Html.PartialAsync("_JournalJdmCommentPartial", post)
            </article>
        }
    </div>

    <div class="pop-up">
        <span>&times;</span>
        <img src="" alt="" />
    </div>