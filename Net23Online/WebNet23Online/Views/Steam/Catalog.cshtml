@using WebNet23Online.Localizations.Steam
@using WebNet23Online.Models.Steam
@using WebNet23Online.Services
@model CatalogViewModel
@{
    Layout = "_LayoutSteam";
}
<main class="page">
    <section class="section">
        <div class="catalog-header">
            <h1 class="page-title">Catalog</h1>
            <div class="catalog-actions">
                <p><a class="btn" href="/Steam/Index">← @CatalogPage.Back_To_Store_Button</a></p>
                @if (Model.IsUserAtLeastModerator)
                {
                    <a class="btn btn-primary" href="/Steam/AddGame">+ @CatalogPage.Add_New_Game_Button</a>
                }
            </div>
        </div>
    </section>

    <section class="section">
        <h2 class="section-title">@CatalogPage.Section_Title_Filter</h2>
        <form method="get" asp-controller="Steam" asp-action="Catalog">
            <input type="hidden" name="page" value="1" />
            <div class="form-group">
                <label>Genre</label>
                <select name="GenreId" class="form-control">
                    <option value="">-- @CatalogPage.Genre_Dropdown_Initial_Value --</option>
                    @foreach (var genre in Model.GameGenres)
                    {
                        <option value="@genre.Value" selected="@(Model.Filter.GenreId?.ToString() == genre.Value ? "selected" : null)">
                            @genre.Text
                        </option>
                    }
                </select>
            </div>

            <div class="form-group">
                <label>@CatalogPage.Max_Price_Filter</label>
                <input type="number" name="MaxPrice" step="0.01" class="form-control"
                       value="@Model.Filter.MaxPrice" />
            </div>

            <div class="form-actions">
                <button type="submit" class="btn btn--primary">@CatalogPage.Apply_Button</button>
                <a href="/Steam/Catalog" class="btn">@CatalogPage.Reset_Button</a>
            </div>
        </form>
    </section>

    <section class="section">
        <h2 class="section-title">@CatalogPage.Section_Title_All_Games (@Model.PaginationMetadata.TotalCount)</h2>

        <div class="cards">
            @foreach (var game in Model.Games)
            {
                <article class="card">
                    <div class="card-media">
                        <img src="@game.ImageUrl" alt="@game.Title" />
                    </div>
                    <div class="card-body">
                        <h3 class="card-title">@game.Title</h3>
                        @if (game.Genres != null && game.Genres.Any())
                        {
                            <div class="feature-genres">
                                @foreach (var genre in game.Genres)
                                {
                                    <span class="game-genre">@genre</span>
                                }
                            </div>
                        }
                        <div class="card-footer">
                            <span class="price">$@game.Price.ToString("0.00")</span>
                            <a class="btn btn--small" href="/Steam/GameDetails/@game.Id">@CatalogPage.View_Button</a>
                        </div>
                    </div>
                </article>
            }
        </div>
        @if (Model.PaginationMetadata.TotalPages > 1)
        {
            <nav class="catalog-pagination" aria-label="Catalog pages">
                @if (Model.PaginationMetadata.HasPreviousPage)
                {
                    <a class="btn"
                       asp-controller="Steam"
                       asp-action="Catalog"
                       asp-route-page="@(Model.PaginationMetadata.CurrentPage - 1)"
                       asp-route-pageSize="@Model.Filter.PageSize"
                       asp-route-genreId="@Model.Filter.GenreId"
                       asp-route-maxPrice="@Model.Filter.MaxPrice">←</a>
                }

                @{
                    var startPageToShow = Math.Max(1, Model.PaginationMetadata.CurrentPage - 2);
                    var endPageToShow = Math.Min(Model.PaginationMetadata.TotalPages, startPageToShow + 4);

                    if (startPageToShow > 1)
                    {
                        <a class="btn"
                           asp-controller="Steam"
                           asp-action="Catalog"
                           asp-route-page="1"
                           asp-route-pageSize="@Model.Filter.PageSize"
                           asp-route-genreId="@Model.Filter.GenreId"
                           asp-route-maxPrice="@Model.Filter.MaxPrice">1</a>

                        if (startPageToShow > 2)
                        {
                            <span class="btn disabled">...</span>
                        }
                    }

                    for (int i = startPageToShow; i <= endPageToShow; i++)
                    {
                        if (i == Model.PaginationMetadata.CurrentPage)
                        {
                            <span class="btn btn-primary active">@i</span>
                        }
                        else
                        {
                            <a class="btn"
                               asp-controller="Steam"
                               asp-action="Catalog"
                               asp-route-page="@i"
                               asp-route-pageSize="@Model.Filter.PageSize"
                               asp-route-genreId="@Model.Filter.GenreId"
                               asp-route-maxPrice="@Model.Filter.MaxPrice">@i</a>
                        }
                    }

                    if (endPageToShow < Model.PaginationMetadata.TotalPages)
                    {
                        if (endPageToShow < Model.PaginationMetadata.TotalPages - 1)
                        {
                            <span class="btn disabled">...</span>
                        }

                        <a class="btn"
                           asp-controller="Steam"
                           asp-action="Catalog"
                           asp-route-page="@Model.PaginationMetadata.TotalPages"
                           asp-route-pageSize="@Model.Filter.PageSize"
                           asp-route-genreId="@Model.Filter.GenreId"
                           asp-route-maxPrice="@Model.Filter.MaxPrice">@Model.PaginationMetadata.TotalPages</a>
                    }
                }

                @if (Model.PaginationMetadata.HasNextPage)
                {
                    <a class="btn"
                       asp-controller="Steam"
                       asp-action="Catalog"
                       asp-route-page="@(Model.PaginationMetadata.CurrentPage + 1)"
                       asp-route-pageSize="@Model.Filter.PageSize"
                       asp-route-genreId="@Model.Filter.GenreId"
                       asp-route-maxPrice="@Model.Filter.MaxPrice">→</a>
                }
            </nav>
        }
    </section>
</main>