@model WebNet23Online.Models.SlayTheSpire2.EditHeroCardFormViewModel
@{
    Layout = "_LayoutSLayTheSpire";
    ViewData["Title"] = $"Редактировать — {Model.Name}";
}

<div class="spire-heroes-detail">
    <p class="spire-heroes-back">
        <a asp-controller="SlayTheSpire2" asp-action="Heroes" asp-route-id="@Model.HeroId" class="spire-navbar-link">← К @(Model.HeroName ?? "герою")</a>
    </p>

    <h1 class="spire-heroes-detail-title">Редактировать карту</h1>

    <form asp-controller="SlayTheSpire2" asp-action="EditCard" method="post" class="spire-hero-add-card-form" novalidate>
        <input type="hidden" asp-for="CardId" />
        <div asp-validation-summary="ModelOnly" class="spire-hero-add-card-errors"></div>

        <label class="spire-hero-add-card-field spire-hero-add-card-field-wide">
            <span>Герой</span>
            <select asp-for="HeroId" asp-items="Model.HeroOptions"></select>
            <span asp-validation-for="HeroId"></span>
        </label>

        <label class="spire-hero-add-card-field">
            <span>Название</span>
            <input asp-for="Name" />
            <span asp-validation-for="Name"></span>
        </label>

        <label class="spire-hero-add-card-field">
            <span>Тип карты</span>
            <select asp-for="TypeOfCard" asp-items="Model.TypeOfCardOptions"></select>
            <span asp-validation-for="TypeOfCard"></span>
        </label>

        <label class="spire-hero-add-card-field">
            <span>Мана</span>
            <input asp-for="ManaCost" type="number" min="0" max="99" />
            <span asp-validation-for="ManaCost"></span>
        </label>

        <label class="spire-hero-add-card-field">
            <span>Редкость</span>
            <select asp-for="Rarity" asp-items="Model.RarityOptions"></select>
            <span asp-validation-for="Rarity"></span>
        </label>

        <label class="spire-hero-add-card-field spire-hero-add-card-field-wide">
            <span>Описание</span>
            <textarea asp-for="Description" rows="3"></textarea>
            <span asp-validation-for="Description"></span>
        </label>

        <label class="spire-hero-add-card-field spire-hero-add-card-field-wide">
            <span>URL изображения</span>
            <input asp-for="ImageUrl" placeholder="/images/slay-the-spire-2/cards/..." />
            <span asp-validation-for="ImageUrl"></span>
        </label>

        <label class="spire-hero-add-card-checkbox">
            <input asp-for="Upgraded" type="checkbox" />
            <span>Улучшенная карта (+)</span>
        </label>

        <button type="submit" class="spire-hero-add-card-submit">Сохранить изменения</button>
    </form>
</div>
