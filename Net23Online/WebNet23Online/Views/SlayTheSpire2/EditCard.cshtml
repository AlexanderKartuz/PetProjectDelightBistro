@model WebNet23Online.Models.SlayTheSpire2.HeroCardFormViewModel
@{
    Layout = "_LayoutSLayTheSpire";
    ViewData["Title"] = Model.IsNew ? "Добавить карту" : $"Редактировать — {Model.Name}";
}

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="~/js/SlayTheSpire2/card-form.js"></script>
}

<div class="spire-heroes-detail">
    <p class="spire-heroes-back">
        <a asp-controller="SlayTheSpire2" asp-action="Heroes" asp-route-id="@Model.HeroId" class="spire-navbar-link">← К @(Model.HeroName ?? "герою")</a>
    </p>

    <h1 class="spire-heroes-detail-title">@(Model.IsNew ? "Добавить карту" : "Редактировать карту")</h1>

    <div class="spire-create-card-page">
        <div class="spire-create-card-form">
            <form asp-action="@(Model.IsNew ? "AddCard" : "EditCard")" method="post" class="spire-hero-add-card-form" novalidate>
                <input type="hidden" asp-for="CardId" />
                <div asp-validation-summary="All" class="spire-hero-add-card-errors"></div>

                <label class="spire-hero-add-card-field spire-hero-add-card-field-wide">
                    <span>Герой</span>
                    <select asp-for="HeroId" asp-items="Model.HeroOptions"></select>
                    <span asp-validation-for="HeroId"></span>
                </label>

                <label class="spire-hero-add-card-field">
                    <span>Название</span>
                    <input asp-for="Name" />
                    <span asp-validation-for="Name"></span>
                </label>

                <label class="spire-hero-add-card-field">
                    <span>Тип карты</span>
                    <select asp-for="TypeOfCard" asp-items="Model.TypeOfCardOptions"></select>
                    <span asp-validation-for="TypeOfCard"></span>
                </label>

                <label class="spire-hero-add-card-field">
                    <span>Мана</span>
                    <input asp-for="ManaCost" type="number" min="0" max="4" />
                    <span asp-validation-for="ManaCost"></span>
                </label>

                <label class="spire-hero-add-card-field">
                    <span>Редкость</span>
                    <select asp-for="Rarity" asp-items="Model.RarityOptions"></select>
                    <span asp-validation-for="Rarity"></span>
                </label>

                <label class="spire-hero-add-card-field spire-hero-add-card-field-wide">
                    <span>Описание</span>
                    <textarea asp-for="Description" rows="3"></textarea>
                    <span asp-validation-for="Description"></span>
                </label>

                <label class="spire-hero-add-card-field spire-hero-add-card-field-wide">
                    <span>URL изображения</span>
                    <input asp-for="ImageUrl" placeholder="/images/slay-the-spire-2/cards/..." />
                    <span asp-validation-for="ImageUrl"></span>
                </label>

                <label class="spire-hero-add-card-checkbox">
                    <input asp-for="Upgraded" type="checkbox" />
                    <span>Улучшенная карта (+)</span>
                </label>

                <button type="submit" class="spire-hero-add-card-submit">@(Model.IsNew ? "Сохранить карту" : "Сохранить изменения")</button>
            </form>
        </div>

        <aside class="spire-create-card-preview" aria-label="Предпросмотр карты">
            <h2 class="spire-create-card-preview-title">Предпросмотр</h2>
            <div class="spire-hero-card spire-hero-card-preview">
                <div class="spire-hero-card-image-frame">
                    <img class="spire-hero-card-image js-preview-image" src="" alt="" loading="lazy" hidden />
                </div>
                <div class="spire-hero-card-body">
                    <p class="spire-hero-card-type js-preview-type"></p>
                    <div class="spire-hero-card-header">
                        <span class="spire-hero-card-mana js-preview-mana" aria-label="Мана">0</span>
                        <h3 class="spire-hero-card-name">
                            <span class="js-preview-name">—</span>
                            <span class="spire-hero-card-upgraded js-preview-upgraded-badge" hidden>+</span>
                        </h3>
                    </div>
                    <p class="spire-hero-card-description js-preview-description"></p>
                    <dl class="spire-hero-card-stats">
                        <dt>Редкость</dt>
                        <dd class="js-preview-rarity">—</dd>
                        <dt>Улучшение</dt>
                        <dd class="js-preview-upgraded">Нет</dd>
                    </dl>
                </div>
            </div>
        </aside>
    </div>
</div>

