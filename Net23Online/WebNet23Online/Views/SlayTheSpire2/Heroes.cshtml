@using WebNet23Online.Models.SlayTheSpire2
@model HeroesViewModel
@{
    Layout = "_LayoutSLayTheSpire";
    ViewData["Title"] = Model.Found ? Model.Name : "Герой";
}

<div class="spire-heroes-detail">
    <p class="spire-heroes-back">
        <a asp-controller="SlayTheSpire2" asp-action="Index" class="spire-navbar-link">← На главную Slay the Spire 2</a>
    </p>

    @if (Model.Found)
    {
        <h1 class="spire-heroes-detail-title">@Model.Name</h1>
        <dl class="spire-heroes-detail-list">
            <dt>Идентификатор в базе</dt>
            <dd>@Model.HeroId</dd>
            <dt>Имя</dt>
            <dd>@Model.Name</dd>
            <dt>Цвет (из базы данных)</dt>
            <dd>@Model.Color</dd>
        </dl>

        <section class="spire-hero-cards" aria-labelledby="hero-cards-heading">
            <h2 id="hero-cards-heading" class="spire-hero-cards-title">Карты героя</h2>

            @if (Model.Cards.Count == 0)
            {
                <p class="spire-hero-cards-empty">Для этого героя в базе пока нет карт.</p>
            }
            else
            {
                <ul class="spire-hero-cards-grid">
                    @foreach (var card in Model.Cards)
                    {
                        <li class="spire-hero-card">
                            <div class="spire-hero-card-image-frame">
                                @if (!string.IsNullOrWhiteSpace(card.ImageUrl))
                                {
                                    <img class="spire-hero-card-image" src="@card.ImageUrl" alt="@card.Name" loading="lazy" />
                                }
                            </div>
                            <div class="spire-hero-card-body">
                                @if (!string.IsNullOrWhiteSpace(card.TypeOfCard))
                                {
                                    <p class="spire-hero-card-type">@card.TypeOfCard</p>
                                }
                                <div class="spire-hero-card-header">
                                    <span class="spire-hero-card-mana" aria-label="Мана">@card.ManaCost</span>
                                    <h3 class="spire-hero-card-name">
                                        @card.Name
                                        @if (card.Upgraded)
                                        {
                                            <span class="spire-hero-card-upgraded">+</span>
                                        }
                                    </h3>
                                </div>
                                @if (!string.IsNullOrWhiteSpace(card.Description))
                                {
                                    <p class="spire-hero-card-description">@card.Description</p>
                                }
                                <dl class="spire-hero-card-stats">
                                    <dt>Редкость</dt>
                                    <dd>@card.Rarity</dd>
                                    <dt>Улучшение</dt>
                                    <dd>@(card.Upgraded ? "Да" : "Нет")</dd>
                                </dl>
                                @if (card.CanEdit)
                                {
                                    <p class="spire-hero-card-actions">
                                        <a asp-controller="SlayTheSpire2" asp-action="EditCard" asp-route-id="@card.Id" class="spire-hero-card-edit">Редактировать</a>
                                    </p>
                                }
                            </div>
                        </li>
                    }
                </ul>
            }

            @if (User.Identity?.IsAuthenticated == true)
            {
            <section class="spire-hero-add-card" aria-labelledby="hero-add-card-heading">
                <h2 id="hero-add-card-heading" class="spire-hero-cards-title">Добавить карту</h2>

                <form asp-controller="SlayTheSpire2" asp-action="AddCard" method="post" class="spire-hero-add-card-form" novalidate>
                    <label class="spire-hero-add-card-field spire-hero-add-card-field-wide">
                        <span>Герой</span>
                        <select asp-for="AddCardForm.HeroId" asp-items="Model.HeroOptions"></select>
                        <span asp-validation-for="AddCardForm.HeroId"></span>
                    </label>
                    <div asp-validation-summary="ModelOnly" class="spire-hero-add-card-errors"></div>

                    <label class="spire-hero-add-card-field">
                        <span>Название</span>
                        <input asp-for="AddCardForm.Name" />
                        <span asp-validation-for="AddCardForm.Name"></span>
                    </label>

                    <label class="spire-hero-add-card-field">
                        <span>Тип карты</span>
                        <select asp-for="AddCardForm.TypeOfCard" asp-items="Model.TypeOfCardOptions"></select>
                        <span asp-validation-for="AddCardForm.TypeOfCard"></span>
                    </label>

                    <label class="spire-hero-add-card-field">
                        <span>Мана</span>
                        <input asp-for="AddCardForm.ManaCost" type="number" min="0" max="99" />
                        <span asp-validation-for="AddCardForm.ManaCost"></span>
                    </label>

                    <label class="spire-hero-add-card-field">
                        <span>Редкость</span>
                        <select asp-for="AddCardForm.Rarity" asp-items="Model.RarityOptions"></select>
                        <span asp-validation-for="AddCardForm.Rarity"></span>
                    </label>

                    <label class="spire-hero-add-card-field spire-hero-add-card-field-wide">
                        <span>Описание</span>
                        <textarea asp-for="AddCardForm.Description" rows="3"></textarea>
                        <span asp-validation-for="AddCardForm.Description"></span>
                    </label>

                    <label class="spire-hero-add-card-field spire-hero-add-card-field-wide">
                        <span>URL изображения</span>
                        <input asp-for="AddCardForm.ImageUrl" placeholder="/images/slay-the-spire-2/cards/..." />
                        <span asp-validation-for="AddCardForm.ImageUrl"></span>
                    </label>

                    <label class="spire-hero-add-card-checkbox">
                        <input asp-for="AddCardForm.Upgraded" type="checkbox" />
                        <span>Улучшенная карта (+)</span>
                    </label>

                    <button type="submit" class="spire-hero-add-card-submit">Сохранить карту</button>
                </form>
            </section>
            }
        </section>
    }
    else
    {
        <h1 class="spire-heroes-detail-title">Герой не найден</h1>
        <p>Для идентификатора <strong>@Model.HeroId</strong> в таблице SlayTheSpire2Heroes нет записи. Обратитесь к высшим силам, чтобы добавить вашего героя в БД.</p>
    }
</div>
