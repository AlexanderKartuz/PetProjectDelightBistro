@using WebNet23Online.Localizations
<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - JDM</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Bebas+Neue&family=Noto+Serif+JP:wght@400;600;700&family=Zen+Kaku+Gothic+New:wght@400;500;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="/css/japanese-domestic-market/jdm-style.css" asp-append-version="true" />
    <script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/6.0.1/signalr.js"></script>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/japanese-domestic-market/notice.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</head>
<body class="jdm-body">
    <div class="notice-box"></div>

    <header class="header">
        <div class="container">
            <div class="header_inner">
                <a class="logo" href="/Jdm/Home">JDM</a>
                <nav class="navigation-menu">
                    <a class="nav-link" href="/Jdm/Home">@JapaneseDomesticMarket.Layout_Home</a>
                    <a class="nav-link" href="/Jdm/Catalog">@JapaneseDomesticMarket.Layout_Advertisements</a>
                    <a class="nav-link" href="/Jdm/CreateCars">@JapaneseDomesticMarket.Layout_Sell_Car</a>
                    <a class="nav-link" href="/Jdm/Journal">@JapaneseDomesticMarket.Layout_Journal</a>
                </nav>
            </div>
        </div>
    </header>

    <main role="main">
        @RenderBody()
    </main>

    <footer class="jdm-footer">
        <div class="container">
            <span class="jdm-footer__brand">JDM</span>
            <span>&copy; 2026 Japanese Domestic Market</span>
        </div>
    </footer>
</body>
</html>
