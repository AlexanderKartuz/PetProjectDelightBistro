@using WebNet23Online.Models.LittleLemon
@using WebNet23Online.Services.Interfaces
@using WebNet23Online.Localizations
@inject IAuthService authService
<!DOCTYPE html>
<html lang="en">
<head>
	<meta charset="utf-8" />
	<meta name="viewport" content="width=device-width, initial-scale=1.0" />
	<title>@ViewData["Title"] - WebNet23Online</title>
	<link rel="stylesheet" href="/css/little-lemon/home-page-styles.css" asp-append-version="true" />
	<link rel="stylesheet" href="/css/little-lemon/reservation.css" asp-append-version="true" />
	<link rel="stylesheet" href="/css/little-lemon/notifications.css" asp-append-version="true" />
	<script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/6.0.1/signalr.js"></script>
	<script src="~/lib/jquery/dist/jquery.min.js"></script>
	<script src="~/js/little-lemon/little-lemon-signalr.js" asp-append-version="true"></script>
	<script src="~/js/little-lemon/reservation-notification.js" asp-append-version="true"></script>
	@RenderSection("Scripts", required: false);
</head>
<body>
	<div class="notifications"></div>
	<template id="reservation-notification-template">
		<div class="notification">
			<h3 class="notification-title"></h3>
			<ul class="notification-details">
				<li data-field="name"></li>
				<li data-field="date"></li>
				<li data-field="time"></li>
				<li data-field="guests"></li>
				<li data-field="seating"></li>
				<li data-field="occasion"></li>
				<li data-field="notes"></li>
				<li data-field="cake" hidden>
					Cake Photo:
					<img class="notification-cake-photo" alt="Cake Photo" />
				</li>
			</ul>
		</div>
	</template>
	<header class="header">
		<div class="header-container">
			<h1 class="header-title">@LittleLemon.Layout_Title</h1>
			<a href="/LittleLemon/Index">
				<img src="/images/little-lemon/icons/logo.png"
					 alt="Little Lemon logo"
					 width="202"
					 height="50"
					 class="header-logo" />
			</a>
			<nav class="header-navbar">
				<ul class="navbar">
					<li><a href="/LittleLemon/Index">@LittleLemon.Layout_Home</a></li>
					<li><a href="#menu">@LittleLemon.Layout_Menu</a></li>
					<li><a href="#about">@LittleLemon.Layout_About</a></li>
					<li><a href="/LittleLemon/Reservation">@LittleLemon.Layout_Reservation</a></li>
					<li><a href="#">@LittleLemon.Layout_OrderOnline</a></li>
					<li><a href="#footer">@LittleLemon.Layout_Contact</a></li>
					@if (authService.IsAuthenticated())
					{
						<li><a href="/LittleLemon/Chat">Chat</a></li>
						<li><a asp-controller="Auth" asp-action="Logout">@LittleLemon.Layout_Logout</a></li>
					}
					else
					{
						<li><a asp-controller="Auth" asp-action="Login">@LittleLemon.Layout_Login</a></li>
					}
				</ul>
			</nav>
		</div>
	</header>
	<main role="main">
		@RenderBody()
	</main>

	<footer id="footer" class="footer">
		<div class="footer-container">
			<div class="footer-content-left">
				<div class="footer-logo">
					<img src="/images/little-lemon/icons/logo.png"
						 alt="Little Lemon logo"
						 width="400"
						 height="100" />
				</div>
				<div class="social-links">
					<ul class="social-links-list">
						<li>
							<a href="https://www.facebook.com/" class="social-link">
								<i class="social-icon icon-1"></i>
								<span>Facebook</span>
							</a>
						</li>
						<li>
							<a href="https://twitter.com/" class="social-link">
								<i class="social-icon icon-2"></i>
								<span>Twitter</span>
							</a>
						</li>
						<li>
							<a href="https://www.instagram.com/" class="social-link">
								<i class="social-icon icon-3"></i>
								<span>Instagram</span>
							</a>
						</li>
						<li>
							<a href="https://www.youtube.com/" class="social-link">
								<i class="social-icon icon-4"></i>
								<span>Youtube</span>
							</a>
						</li>
					</ul>
				</div>
			</div>
			<div class="footer-content-middle">
				<nav class="footer-navigation">
					<ul class="navbar">
						<li><a href="/LittleLemon/Index">@LittleLemon.Layout_Home</a></li>
						<li><a href="#about">@LittleLemon.Layout_About</a></li>
						<li><a href="#menu">@LittleLemon.Layout_Menu</a></li>
						<li>
							<a href="/LittleLemon/Reservation">@LittleLemon.Layout_Reservation</a>
						</li>
						<li><a href="#menu">@LittleLemon.Layout_Menu</a></li>
						@if (authService.IsAuthenticated())
						{
							<li><a asp-controller="Auth" asp-action="Logout">@LittleLemon.Layout_Logout</a></li>
						}
						else
						{
							<li><a asp-controller="Auth" asp-action="Login">@LittleLemon.Layout_Login</a></li>
						}
					</ul>
				</nav>
			</div>
			<div class="footer-content-right">
				<form asp-controller="LittleLemon" asp-action="Subscribe" method="post" class="form">
					<label for="subscribe">@LittleLemon.Layout_Subscribe_Label</label>
					<div>
						<input type="hidden" name="returnUrl" value="@Context.Request.Path" />
						<input type="email"
							   name="Email"
							   id="subscribe"
							   placeholder="@LittleLemon.Layout_Subscribe_EmailPlaceholder"
							   required
							   autocomplete="email" />
						<input type="submit" value="@LittleLemon.Layout_Subscribe_Submit" />
					</div>
				</form>
				@{
					var subscribeMessage = TempData
						[LittleLemonSubscribeViewModel.MESSAGE_KEY]?.ToString();
				}
				@if (!string.IsNullOrEmpty(subscribeMessage))
				{
					<p class="subscribe-feedback">@subscribeMessage</p>
				}
				<div class="address">
					<p>53, East Birchwood Ave. Brooklyn, New York 11201, USA.</p>
					<p>contact@littlelemon.com</p>
					<p>(123) 456 - 7890</p>
				</div>
			</div>
		</div>
	</footer>
</body>
</html>
