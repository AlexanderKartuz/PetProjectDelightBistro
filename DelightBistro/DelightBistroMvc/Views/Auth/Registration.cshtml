@using DelightBistroMvc.Models.Auth;

@model RegisterViewModel

@section Scripts {
    <link rel="stylesheet" href="/css/auth/style.css">
    <script src="~/js/auth/registration.js"></script>
}

<div class="registration-container">
    <form method="post" asp-action="Registration" asp-controller="Auth">
        @Html.AntiForgeryToken()
        <div class="registration-header">Регситрация</div>
        <div asp-validation-summary="ModelOnly" class="text-danger"></div>
        <div class="mb-5">
            <label asp-for="Login" class="form-label"></label>
            <input asp-for="Login" class="form-control" placeholder="Введите логин" />
            <span asp-validation-for="Login" class="text-danger"></span>
            <img class="icon wait" src="/icons/waiter.gif" />
            <img class="icon ok" src="/icons/ok.png" />
            <img class="icon deny" src="/icons/deny.jpg" />
        </div>

        <div class="mb-5">
            <label asp-for="Password" class="form-label"></label>
            <div class="input-group">
                <input asp-for="Password" class="form-control" placeholder="Введите пароль" />
                <span asp-validation-for="Password" class="text-danger"></span>
            </div>
            <div class="mb-5">
                <label asp-for="ConfirmPassword" class="form-label"></label>
                <div class="input-group">
                    <input asp-for="ConfirmPassword" class="form-control" placeholder="Подтвердите пароль" />
                    <span asp-validation-for="ConfirmPassword" class="text-danger"></span>
                </div>
            </div>

            <div class="mb-5">
                <label asp-for="FirstName" class="form-label"></label>
                <input asp-for="FirstName" class="form-control" placeholder="Введите имя (необязательно)" />
                <span asp-validation-for="FirstName" class="text-danger"></span>
            </div>

            <div class="mb-5">
                <label asp-for="LastName" class="form-label"></label>
                <input asp-for="LastName" class="form-control" placeholder="Введите Фамилию (необязательно)" />
                <span asp-validation-for="LastName" class="text-danger"></span>
            </div>
            <div class="mb-5">
                <label asp-for="Mobilephone" class="form-label"></label>
                <input asp-for="Mobilephone" class="form-control" placeholder="Введите телефон (необязательно)" />
                <span asp-validation-for="Mobilephone" class="text-danger"></span>
            </div>
        </div>
        <div class="mb-5">
            <button type="submit" class="btn btn-primary w-100">Register</button>
        </div>
    </form>
</div>