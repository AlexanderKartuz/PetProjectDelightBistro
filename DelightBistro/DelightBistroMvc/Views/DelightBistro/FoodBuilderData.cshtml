@using DelightBistroMvc.Models.DelightBistro;

@{
    Layout = "_LayoutDelightBistro";
}
@model CreateFoodItemViewModel

@section Scripts {
    <script src="/js/delight-bistro/preview-food-item.js"></script>

    <link rel="stylesheet" href="/css/delight-bistro/style.css" />
}


<div class="create-food-box food-builder-page">
    <div class="form-title">
        Добавьте блюдо. Заполните все поля в форме
    </div>
    @if (Model.Id > 0)
    {
        <div class="change-food">
            <img src=@Model.ImgUrl alt=@Model.Name />
        </div>
    }

    <div class="food-builder-preview">
        <div class="preview food-item">
            <div class="preview-title">Preview</div>
            <div class="preview-image-container">
                <img src="" alt="image" />
            </div>
            <div class="name-price">
                <div class="preview-menu-name">Menu</div>
                <div class="preview-food-name">Name</div>
                <div class="preview-price">Price</div>
            </div>
            <div class="preview-recept">
                <ul>
                    <li>Ингредиенты и количество</li>
                </ul>
            </div>
        </div>
    </div>

    <form method="post" enctype="multipart/form-data" class="food-builder-form">
        @Html.HiddenFor(x => x.Id)

        <div class="form-section dish-info-section">
            <div class="form-section-title">Основная информация</div>
            <div class="dish-info-fields">
                <div class="form-field">
                    <label class="form-field-label" for="Name">Название блюда</label>
                    @Html.TextBoxFor(x => x.Name, new { type = "text", required = "required", placeholder = "Имя блюда", data_test = "food-name" })
                    @Html.ValidationMessageFor(x => x.Name)
                </div>
                <div class="form-field">
                    <label class="form-field-label" for="Price">Цена блюда</label>
                    @Html.TextBoxFor(x => x.Price, new { type = "number", required = "required", placeholder = "Стоимость", data_test = "food-price" })
                    @Html.ValidationMessageFor(x => x.Price)
                </div>
                <div class="form-field">
                    <label class="form-field-label" for="MenuId">Тип меню</label>
                    @Html.DropDownListFor(x => x.MenuId, Model.Menus, "Выберите меню", new { data_test = "menu-list" })
                </div>
            </div>
        </div>

        <div class="form-section ingredients-section">
            <div class="form-section-title">Выберите ингредиенты</div>
            <div class="ingredients-grid">
                @for (var i = 0; i < Model.IngredientsList.Count; i++)
                {
                    <div class="ingredient-row" data-test="ingredient-name" data-index="@i">
                        @Html.HiddenFor(x => x.IngredientsList[i].Id)
                        @Html.HiddenFor(x => x.IngredientsList[i].Name)
                        <label class="ingredient-label">
                            @Html.CheckBoxFor(x => x.IngredientsList[i].IsSelected, new { data_ingredient_name = Model.IngredientsList[i].Name, data_test = $"ingredient-checked-box-{i}" })
                            <span class="ingredient-name">@Model.IngredientsList[i].Name</span>
                        </label>
                        @Html.TextBoxFor(x => x.IngredientsList[i].Quantity, new
                        {
                            type = "number",
                            min = "1",
                            placeholder = "г",
                            @class = "ingredient-quantity",
                            data_test = $"ingredient-quantity-{i}",
                        })
                        @Html.ValidationMessageFor(x => x.IngredientsList[i].Name)
                    </div>
                }
            </div>
        </div>

        <div class="form-section image-section">
            <div class="form-section-title">Изображение</div>
            <input type="file" name="Image" class="image-file-input" />
            @Html.TextBoxFor(x => x.ImgUrl, new { type = "string", placeholder = "Добавьте URL изображения", data_test = "imgUrl", @class = "image-url-input" })
            @Html.ValidationMessageFor(x => x.ImgUrl)
        </div>

        <div class="food-create-button">
            <button type="submit" data-test="submit-button">@(Model.Id > 0 ? "Сохранить блюдо" : "Добавить блюдо")</button>
        </div>
    </form>
</div>
