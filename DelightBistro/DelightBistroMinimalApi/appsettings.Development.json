{
  "ConnectionStrings": {
    "Drinks": "Data Source=(localdb)\\MSSQLLocalDB;Initial Catalog=WebNet23Tea;Integrated Security=True;Connect Timeout=30;",
    "Logging": "Data Source=(localdb)\\MSSQLLocalDB;Initial Catalog=WebNet23Tea;Integrated Security=True;Connect Timeout=30;",
    "Redis": "localhost:6379",
    "Users": "Data Source=(localdb)\\MSSQLLocalDB;Initial Catalog=WebNet23Online;Integrated Security=True;Connect Timeout=30;"
  },

  "Caching": {
    "Provider": "Memory",
    "InstanceName": "DelightBistro_"
  },

  "Logging": {
    "Console": {
      "restrictedToMinimumLevel": "Information"
    },
    "File": {
      "restrictedToMinimumLevel": "Warning"
    },
    "MSSqlServer": {
      "schema": "Logging",
      "tableName": "SeriLogs",
      "restrictedToMinimumLevel": "Warning"
    }
  },

  "ApplicationName": "DelightBistro.Api - Dev",

  "AllowedHosts": "*",
  "GlobalRateLimitingOptions": {
    "PermitLimit": 200,
    "WindowSeconds": 30,
    "SegmentsPerWindow": 3,
    "QueueLimit": 5,
    "QueueOrder": "OldestFirst"

  },
  "IpRateLimitingOptions": {
    "PermitLimit": 30,
    "WindowSeconds": 30,
    "SegmentsPerWindow": 3,
    "QueueLimit": 0,
    "QueueOrder": "OldestFirst"
  },

  "Jwt": {
    "Issuer": "DelightBistro.Api",
    "Audience": "DelightBistro.Client",
    "Key": "DEV_ONLY_CHANGE_ME_32chars_minimum!!",
    "ExpireMinutes": 60
  }
}
